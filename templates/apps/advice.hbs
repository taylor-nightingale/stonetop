{{!-- One "If you want to…" topic, plus the reference sidebar for the same thing when the book has
      one. The topic's own heading is the window title, so its prose needs no heading; the sidebar
      does, because it answers a different question ("what IS a purse?") from a different page. --}}
<div class="stonetop-advice">
	{{> "stonetop.prose-blocks" blocks=advice.blocks}}

	{{#if reference}}
	<section class="stonetop-advice-reference">
		<h3>{{reference.title}}</h3>
		{{> "stonetop.prose-blocks" blocks=reference.blocks}}
	</section>
	{{/if}}
</div>
