{{!-- ApplicationV2 part: the sheet root IS the <form> (DocumentSheetV2 tag) and carries the
      stonetop/sheet/item/improvement classes from DEFAULT_OPTIONS. HandlebarsApplicationMixin
      requires each part to render a SINGLE root element — hence this wrapper div.

      The improvement is its board card, and is edited as that card (improvement-editor.hbs). Above
      it, and visibly apart, what the steading never draws: the image the Items directory shows. A
      locked improvement is the board's own card, and nothing more. --}}
<div class="stonetop-improvement-sheet">

	<header class="stonetop-improvement-sheet-catalog" aria-label="{{localize 'stonetop.improvement.catalog'}}">
		{{#if editable}}
		<button type="button" class="stonetop-image-btn" data-action="editImage" aria-label="{{localize 'stonetop.improvement.image'}}"><img data-edit="img" class="stonetop-insert-sheet-icon" src="{{item.img}}" alt=""></button>
		{{else}}
		<img class="stonetop-insert-sheet-icon" src="{{item.img}}" alt="">
		{{/if}}
	</header>

	<div class="stonetop-improvement-sheet-card">
		{{#if editable}}
			{{> "stonetop.improvement-editor"}}
		{{else}}
			{{#with card}}{{> "stonetop.steading-improvement-card"}}{{/with}}
		{{/if}}
	</div>

</div>
