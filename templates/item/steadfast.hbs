{{!-- V2 part: single root element; the sheet root form + classes (including the intentional
      `steading` class, which opts this item sheet into the shared steading profile styling) come
      from DEFAULT_OPTIONS. Steadfast-only layout tweaks live under `.stonetop.sheet.steadfast`. --}}
<div class="stonetop-item-sheet-part">

	<header class="stonetop-insert-sheet-header">
		<button type="button" class="stonetop-image-btn" data-action="editImage" aria-label="{{stonetop.name}}"><img data-edit="img" class="stonetop-insert-sheet-icon" src="{{stonetop.img}}" title="{{stonetop.name}}" alt=""></button>
		<h1 class="charname stonetop-insert-sheet-name">
			<input type="text" name="name" value="{{stonetop.name}}"
			       placeholder="{{localize 'stonetop.steadfast.namePlaceholder'}}"
			       {{#unless editable}}disabled{{/unless}}
		       aria-label="{{localize 'stonetop.steadfast.namePlaceholder'}}">
		</h1>
	</header>

	<div class="stonetop-steadfast-body">

		{{!-- Ratings, at the full density — this is a page, not a line, so it gets the same treatment
		      the steading's Play tab gets: the two the book arches, then the four it rules plainly. --}}
		<section class="steading-ledger stonetop-steadfast-ratings" data-density="full">

			<div class="steading-archpair">
				{{> "stonetop.steading-stat-panel" attr="fortunes" attrData=stonetop.fortunes panelClass="steading-fortunes steading-tile--arched"}}
				{{> "stonetop.steading-stat-panel" attr="surplus"  attrData=stonetop.surplus  panelClass="steading-surplus steading-tile--arched"}}
			</div>

			<div class="stonetop-steadfast-rating-row">
				{{> "stonetop.steading-stat-panel" attr="size"       attrData=stonetop.attributes.size       panelClass="steading-size"}}
				{{> "stonetop.steading-stat-panel" attr="population" attrData=stonetop.attributes.population panelClass="steading-population"}}
				{{> "stonetop.steading-stat-panel" attr="prosperity" attrData=stonetop.attributes.prosperity panelClass="steading-prosperity"}}
				{{> "stonetop.steading-stat-panel" attr="defenses"   attrData=stonetop.attributes.defenses   panelClass="steading-defenses"}}
			</div>

		</section>

		{{!-- Resources / Fortifications / Assets --}}
		<section class="steading-overview-grid stonetop-steadfast-assets" data-density="full">
			<section class="steading-overview-column">
				{{> "stonetop.steading-ratings-list" title=(localize "stonetop.steading.lists.resources") addLabel=(localize "stonetop.steading.lists.addResource") attr="prosperity" items=stonetop.attributes.prosperity.items}}
			</section>
			<section class="steading-overview-column">
				{{> "stonetop.steading-ratings-list" title=(localize "stonetop.steading.lists.fortifications") addLabel=(localize "stonetop.steading.lists.addFortification") attr="defenses" items=stonetop.attributes.defenses.items}}
			</section>
			<section class="steading-overview-column steading-assets-column">
				{{> "stonetop.steading-assets" items=stonetop.assets.items}}
			{{> "stonetop.steading-coinage" coinage=stonetop.assets.coinage}}
			</section>
		</section>

		{{!-- Places of Interest --}}
		<section class="stonetop-steadfast-section">
			{{> "stonetop.steading-places-of-interest" places=stonetop.placesOfInterest}}
		</section>

		{{!-- Neighbouring places --}}
		{{#if stonetop.neighbors.places.length}}
		<section class="stonetop-steadfast-section">
			{{> "stonetop.steading-neighbor-places" title=(localize "stonetop.steading.headings.neighbors")
			   places=stonetop.neighbors.places showNames=true editableSize=true editableTravel=true}}
		</section>
		{{/if}}

		{{!-- Resident name / trait pool --}}
		<section class="stonetop-steadfast-section steading-npc-traits steading-block">
			{{> "stonetop.section-heading" title="Residents"
			    note="The name and trait pools this place seeds — suggestions for generating residents."}}
			<label class="stonetop-insert-sheet-label" for="steadfast-resident-names">Names</label>
			<textarea id="steadfast-resident-names" class="stonetop-steadfast-resident-names" rows="2"
			          {{#unless editable}}disabled{{/unless}}>{{stonetop.residentNames}}</textarea>
			<label class="stonetop-insert-sheet-label">NPC Traits</label>
			<textarea class="steading-npc-traits-source" aria-label="{{localize 'stonetop.a11y.npcTraits'}}" {{#unless editable}}disabled{{/unless}}>{{stonetop.residentTraitsText}}</textarea>
			<div class="steading-npc-traits-columns">
				{{#each stonetop.npcTraitColumns}}
					<div class="steading-npc-traits-column">
						{{#each this}}<div class="steading-npc-trait">{{this}}</div>{{/each}}
					</div>
				{{/each}}
			</div>
		</section>

		{{!-- Granted improvements --}}
		<section class="stonetop-steadfast-section stonetop-steadfast-improvements">
			{{> "stonetop.section-heading" title=(localize "stonetop.steadfast.improvements")
			    note=(localize "stonetop.steadfast.improvementsHint")}}
			<div class="steading-improvements-grid stonetop-steadfast-improvement-list">
				{{#each stonetop.improvements}}
					<div class="steading-improvement-group steading-block stonetop-steadfast-improvement">
						{{#if @root.editable}}
						<button type="button" class="steadfast-improvement-remove stonetop-icon-btn"
						        data-slug="{{slug}}" data-name="{{slug}}"
						        title="{{localize 'stonetop.steadfast.improvementRemove'}}" aria-label="Remove">
							<img src="systems/stonetop/assets/ui/controls/delete-icon.png" alt="">
						</button>
						{{/if}}
						{{> "stonetop.improvement-group"}}
					</div>
				{{else}}
					<p class="stonetop-insert-sheet-empty">{{localize "stonetop.steadfast.improvementsEmpty"}}</p>
				{{/each}}
			</div>
		</section>

	</div>
</div>
