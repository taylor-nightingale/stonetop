<label class="choices-field">
	<span>Title</span>
	<input type="text"
	       data-choices-target="{{_target}}" data-choices-row-index="{{_rowIndex}}" {{#if _hasOptionIndex}}data-choices-option-index="{{_optionIndex}}"{{/if}} data-choices-field="content.title"
	       value="{{content.title}}">
</label>
<label class="choices-field">
	<span>Title note</span>
	<input type="text"
	       data-choices-target="{{_target}}" data-choices-row-index="{{_rowIndex}}" {{#if _hasOptionIndex}}data-choices-option-index="{{_optionIndex}}"{{/if}} data-choices-field="content.titleNote"
	       value="{{content.titleNote}}">
</label>
<label class="choices-field">
	<span>Subtitle</span>
	<input type="text"
	       data-choices-target="{{_target}}" data-choices-row-index="{{_rowIndex}}" {{#if _hasOptionIndex}}data-choices-option-index="{{_optionIndex}}"{{/if}} data-choices-field="content.subtitle"
	       value="{{content.subtitle}}">
</label>
<label class="choices-field">
	<span>Subtitle note</span>
	<input type="text"
	       data-choices-target="{{_target}}" data-choices-row-index="{{_rowIndex}}" {{#if _hasOptionIndex}}data-choices-option-index="{{_optionIndex}}"{{/if}} data-choices-field="content.subtitleNote"
	       value="{{content.subtitleNote}}">
</label>
<label class="choices-field choices-field--rich">
	<span>Text</span>
	{{!-- Rich body text: seeded with HTML (content.textHtml = md→HTML) and saved back as HTML through
	      the choiceGroupEditorMixin change handler (whole-group atomic write). --}}
	<prose-mirror class="choices-rich-text"
	       data-choices-target="{{_target}}" data-choices-row-index="{{_rowIndex}}" {{#if _hasOptionIndex}}data-choices-option-index="{{_optionIndex}}"{{/if}} data-choices-field="content.text"
	       value="{{content.textHtml}}"></prose-mirror>
</label>
<div class="choices-field">
	<span>Followers</span>
	<input type="text"
	       data-choices-target="{{_target}}" data-choices-row-index="{{_rowIndex}}" {{#if _hasOptionIndex}}data-choices-option-index="{{_optionIndex}}"{{/if}} data-choices-field="followers.slugs"
	       value="{{followers.slugs}}" placeholder="e.g. enfys,rook"
		       aria-label="e.g. enfys,rook">
	<label class="choices-field-inline-check">
		<input type="checkbox"
		       data-choices-target="{{_target}}" data-choices-row-index="{{_rowIndex}}" {{#if _hasOptionIndex}}data-choices-option-index="{{_optionIndex}}"{{/if}} data-choices-field="followers.inlineDisplay"
		       {{#if followers.inlineDisplay}}checked{{/if}}>
		<span>Show full follower card</span>
	</label>
	<label class="choices-field-inline-check">
		<input type="checkbox"
		       data-choices-target="{{_target}}" data-choices-row-index="{{_rowIndex}}" {{#if _hasOptionIndex}}data-choices-option-index="{{_optionIndex}}"{{/if}} data-choices-field="followers.hideFromFollowersTab"
		       {{#if followers.hideFromFollowersTab}}checked{{/if}}>
		<span>Hide from followers tab</span>
	</label>
</div>
<div class="choices-field">
	<span>Outfit items</span>
	{{#each outfitItems}}
	<div class="choices-outfit-item">
		<input type="text" placeholder="slug"
		       data-choices-target="{{../_target}}" data-choices-row-index="{{../_rowIndex}}" {{#if ../_hasOptionIndex}}data-choices-option-index="{{../_optionIndex}}"{{/if}} data-choices-field="outfitItems.{{@index}}.slug"
		       value="{{slug}}"
		       aria-label="slug">
		<input type="text" placeholder="name"
		       data-choices-target="{{../_target}}" data-choices-row-index="{{../_rowIndex}}" {{#if ../_hasOptionIndex}}data-choices-option-index="{{../_optionIndex}}"{{/if}} data-choices-field="outfitItems.{{@index}}.name"
		       value="{{name}}"
		       aria-label="name">
		<input type="number" placeholder="wt" min="0"
		       data-choices-target="{{../_target}}" data-choices-row-index="{{../_rowIndex}}" {{#if ../_hasOptionIndex}}data-choices-option-index="{{../_optionIndex}}"{{/if}} data-choices-field="outfitItems.{{@index}}.weight"
		       value="{{weight}}"
		       aria-label="wt">
		<select data-choices-target="{{../_target}}" data-choices-row-index="{{../_rowIndex}}" {{#if ../_hasOptionIndex}}data-choices-option-index="{{../_optionIndex}}"{{/if}} data-choices-field="outfitItems.{{@index}}.inventoryColumn"
		        aria-label="{{localize 'stonetop.a11y.inventoryColumn'}}">
			<option value="regular" {{#if (eq inventoryColumn "regular")}}selected{{/if}}>regular</option>
			<option value="small"   {{#if (eq inventoryColumn "small")}}selected{{/if}}>small</option>
		</select>
		<button type="button" class="choices-outfit-item-delete"
		        data-row-index="{{../_rowIndex}}" {{#if ../_hasOptionIndex}}data-option-index="{{../_optionIndex}}"{{/if}} data-outfit-item-index="{{@index}}">×</button>
	</div>
	{{/each}}
	<button type="button" class="choices-add-outfit-item"
	        data-row-index="{{_rowIndex}}" {{#if _hasOptionIndex}}data-option-index="{{_optionIndex}}"{{/if}}>+ Outfit Item</button>
</div>
