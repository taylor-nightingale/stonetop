{{!-- What the chosen "the sheet …" asks for, under it: which rating and by how much, which list and
      what it writes, which rating and to what. Nothing, for a result the table carries out.

      Context: an ImprovementEditorResult. --}}
{{#if ratingModes}}
	<div class="stonetop-improvement-rings">
		{{> "stonetop.roll-mode-picker" modes=ratingModes name=(concat nameBase "-rating") changeAction="resultRating"
		    legendKey="stonetop.improvement.does.rating"}}
	</div>
{{/if}}
{{#if isChange}}
	<label class="stonetop-improvement-sentence">
		<span>{{localize "stonetop.improvement.does.amount"}}</span>
		<span class="stonetop-stepper">
			<input type="number" class="stonetop-step" step="1" data-change-action="resultAmount" value="{{amount}}"
			       aria-label="{{localize 'stonetop.improvement.does.amount'}}">
			{{> "stonetop.stepper-buttons"}}
		</span>
	</label>
{{/if}}
{{#if setValueModes}}
	<div class="stonetop-improvement-rings">
		{{> "stonetop.roll-mode-picker" modes=setValueModes name=(concat nameBase "-value") changeAction="resultSetValue"
		    legendKey="stonetop.improvement.does.value"}}
	</div>
{{else if isSet}}
	<label class="stonetop-improvement-sentence">
		<span>{{localize "stonetop.improvement.does.value"}}</span>
		<input type="number" step="1" data-change-action="resultSetValue" value="{{setValue}}" aria-label="{{localize 'stonetop.improvement.does.value'}}">
	</label>
{{/if}}
{{#if listModes}}
	<div class="stonetop-improvement-rings">
		{{> "stonetop.roll-mode-picker" modes=listModes name=(concat nameBase "-list") changeAction="resultList"
		    legendKey="stonetop.improvement.does.whichList"}}
	</div>
	<label class="stonetop-improvement-sentence">
		<span>{{localize "stonetop.improvement.does.entry"}}</span>
		<input type="text" class="stonetop-improvement-phrase" data-change-action="resultEntry" value="{{entry}}"
		       aria-label="{{localize 'stonetop.improvement.does.entry'}}" placeholder="{{localize 'stonetop.improvement.placeholder.entry'}}">
	</label>
{{/if}}
