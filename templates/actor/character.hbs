{{!-- Single part root (V2 renders the <form> window root itself). The playbook-specific class
      lives here because root classes are static in ApplicationV2. --}}
<div class="sheet-wrapper stonetop-playbook-{{stonetop.playbook.slug}}">

	{{> "stonetop.actor-header"}}

	<section class="sheet-top flexrow">
		<div class="stonetop-stats-column">
			{{> "stonetop.section-heading" title=(localize "stonetop.character.stats.sectionTitle") note=stonetop.playbook.statsNote}}

			<div class="stonetop-stats-section">
				{{> "stonetop.actor-stats" stats=stonetop.stats}}
			</div>
			<div class="stonetop-debilities">
				{{#each stonetop.debilities}}
				<div class="stonetop-debility">
					{{!-- Two groups, not four siblings: the divider art and the tick it frames belong
					      to one band, and the name sits below it in normal flow. Everything used to
					      be absolutely positioned against hand-measured pixel offsets, so the name
					      climbed into the art as soon as Foundry's font setting grew it. --}}
					<label class="stonetop-debility-control"
					       data-tooltip="{{description}}" data-tooltip-direction="UP">
						<span class="stonetop-debility-band">
							<span class="stonetop-debility-divider"></span>
							<input type="checkbox" class="stonetop-debility-check"
							       data-change-action="debility"
							       data-slug="{{key}}"
							       {{#if active}}checked{{/if}}>
						</span>
						<span class="stonetop-debility-label">{{key}}</span>
					</label>
				</div>
				{{/each}}
			</div>

			<div class="stonetop-vitals-section">
				{{> "stonetop.actor-attributes"}}
			</div>

			{{!-- Under the XP track it reads, because that is the number it is about. Renders nothing
			      at all unless the Level Up move has triggered or left something outstanding. --}}
			{{> "stonetop.level-up-strip"}}
		</div>

		<div class="stonetop-actor-portrait">
			<button type="button" class="stonetop-image-btn" data-action="editImage" aria-label="{{actor.name}}"><img data-edit="img" class="stonetop-actor-portrait-img" src="{{actor.img}}"
			     alt="{{actor.name}}" title="{{actor.name}}"></button>
		</div>
	</section>

	<section class="sheet-main flexcol">
		{{!-- data-action="tab" is core ApplicationV2's built-in action (→ changeTab); context.tabs
		      already carries the per-insert tabs via the sheet's _getTabsConfig override. --}}
		<nav class="sheet-tabs tabs" data-group="primary">
			{{#each tabs}}
			<button type="button" class="item {{this.cssClass}}" data-action="tab" data-group="primary" data-tab="{{this.id}}">{{localize this.label}}</button>
			{{/each}}
			<button type="button" class="stonetop-top-toggle" data-action="toggleTop" data-view-state title="{{localize 'stonetop.sheet.collapseTop'}}" aria-label="{{localize 'stonetop.sheet.collapseTop'}}">
				<i class="fas fa-chevron-up"></i>
			</button>
		</nav>

		{{!-- The moves rail. `data-side` is the only thing that says which edge it is on; the shared
		      rail stylesheet reads it, so the steading's left-hand rail is the same component. --}}
		<div class="stonetop-rail-layout" data-side="right">
			<button type="button" class="stonetop-rail-toggle" data-action="toggleRail" data-view-state
			        aria-expanded="false" aria-controls="{{sheetIdPrefix}}-moves-rail"
			        data-label-show="{{localize 'stonetop.sheet.railShow'}}"
			        data-label-hide="{{localize 'stonetop.sheet.railHide'}}"
			        title="{{localize 'stonetop.sheet.railShow'}}"
			        aria-label="{{localize 'stonetop.sheet.railShow'}}">
				<i class="fas fa-chevron-left stonetop-rail-caret" aria-hidden="true"></i>
				<span class="stonetop-rail-fold" aria-hidden="true">
					<i class="fas fa-bolt stonetop-rail-mark"></i>
					<i class="fas fa-dice-d6 stonetop-rail-mark"></i>
				</span>
			</button>
			<section class="sheet-body stonetop-rail-main">
				{{> "stonetop.tab-playbook"}}
				{{> "stonetop.tab-moves"}}
				{{> "stonetop.tab-possessions"}}
				{{> "stonetop.tab-equipment"}}
				{{> "stonetop.tab-arcana"}}
				{{> "stonetop.tab-followers"}}
				{{> "stonetop.tab-notes"}}
				{{#each stonetop.inserts}}{{> "stonetop.tab-insert" insert=this tab=(lookup @root.tabs (concat "insert-" slug))
				    viewFlag=(concat "insertLocked-" slug) locked=(lookup @root.viewFlags (concat "insertLocked-" slug))}}{{/each}}
			</section>

			<div class="stonetop-rail stonetop-moves-rail" id="{{sheetIdPrefix}}-moves-rail">
				{{!-- Roll Mode --}}
				<div class="stonetop-outfit-header">
					{{> "stonetop.roll-mode-picker" modes=stonetop.rollModes name="stonetop-roll-mode" changeAction="rollMode"}}
				</div>

				{{#each stonetop.moves.categories}}
				{{#if (eq renderStyle "side-bar")}}
				{{> "stonetop.section-heading" title=label}}
				<ol class="items-list">
				{{#each moves}}
					{{#if (and ownedId rollStat)}}
					<li class="item stonetop-move-item" data-item-id="{{ownedId}}">
					{{else}}
					<li class="stonetop-move-item move-unowned">
					{{/if}}
						{{#if (and ownedId rollStat)}}
						{{!-- A <button>, as in move-item.hbs: the die is a control on both surfaces, so it is
						      reachable and lights up the same way on both. --}}
						<button type="button" class="rollable move-rollable" data-roll="{{rollStat}}" data-mod=""
						        title="{{localize 'stonetop.a11y.rollMove' name=name}}"
						        aria-label="{{localize 'stonetop.a11y.rollMove' name=name}}">
							<i class="fas fa-dice-d6" aria-hidden="true"></i>
						</button>
						{{/if}}
						<button type="button" class="stonetop-move-name stonetop-basic-move-open" data-action="openBasicMove"
					      data-compendium-id="{{id}}">{{name}}</button>
						<button type="button" class="stonetop-move-chat" data-action="moveToChat" data-move-slug="{{slug}}"
						   title="{{localize 'stonetop.character.moves.sendToChat'}}" aria-label="{{localize 'stonetop.character.moves.sendToChat'}}">
							<i class="fas fa-comment"></i>
						</button>
						{{!-- A reference move that holds something (Defend's Readiness) tracks it here: the
						      sidebar is the only surface these moves render on, and the track is the shared
						      one the moves tab draws, so a pip behaves the same wherever it appears. --}}
						{{#if resource}}
						<span class="stonetop-item-resources">
							{{> "stonetop.resource-track" resource=resource btnClass="stonetop-item-resource-check"
							    action="moveResourcePip" moveSlug=slug slug=slug}}
						</span>
						{{/if}}
					</li>
				{{/each}}
				</ol>
				{{/if}}
				{{/each}}
			</div>
		</div>
	</section>

</div>
