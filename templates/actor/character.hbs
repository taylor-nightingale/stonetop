{{!-- Single part root (V2 renders the <form> window root itself). The playbook-specific class
      lives here because root classes are static in ApplicationV2. --}}
<div class="sheet-wrapper stonetop-playbook-{{stonetop.playbook.slug}}">

	{{!-- The rail, and everything beside it.

	      The layout is the OUTER container, as on the steading: the rail runs the whole sheet height,
	      from under the title bar past the tab rule, rather than starting below a header band.

	      The rail is the MOVES rail. That is the one structural rule this sheet has: rolling a move
	      needs the stat AND the move, so stats and moves cannot share one scrolling column — put
	      both in here and they become mutually exclusive, which is exactly what happened. What the
	      rail carries beside the moves is Advancement, which is read once a session.

	      Left, and the same rail as the steading's: one component, one tab on its edge. --}}
	<div class="stonetop-rail-layout">
		<button type="button" class="stonetop-rail-toggle" data-action="toggleRail" data-view-state
		        aria-expanded="false" aria-controls="{{sheetIdPrefix}}-moves-rail"
		        data-label-show="{{localize 'stonetop.sheet.railShow'}}"
		        data-label-hide="{{localize 'stonetop.sheet.railHide'}}"
		        title="{{localize 'stonetop.sheet.railShow'}}"
		        aria-label="{{localize 'stonetop.sheet.railShow'}}">
			<i class="fas fa-chevron-left stonetop-rail-caret" aria-hidden="true"></i>
		</button>

		<div class="stonetop-rail stonetop-moves-rail" id="{{sheetIdPrefix}}-moves-rail">

			{{!-- D7: who this is and what state they are in, then what they are becoming, then the verbs
			      they reach for. A conditional move appears when its condition is met and not otherwise
			      (D9); the compendium is what makes that safe, since the sheet is not the only copy. --}}
			{{> "stonetop.rail-identity"}}

			{{> "stonetop.rail-meter" kind="hp" label=(localize "stonetop.character.attributes.hp") meter=stonetop.vitals.hpMeter
			    valueAction="hp" valueLabel=(localize "stonetop.a11y.hpCurrent")
			    maxAction="maxHp" maxLabel=(localize "stonetop.a11y.hpMax") tooltip=stonetop.vitals.sources.hp
			    tone=(ifThen stonetop.vitals.hpMeter.isLow "danger" "life")
			    describedBy=(ifThen (hasText stonetop.vitals.sources.hp) (concat sheetIdPrefix "-vital-hp-source") "")}}
			{{#if (hasText stonetop.vitals.sources.hp)}}<span id="{{sheetIdPrefix}}-vital-hp-source" class="stonetop-visually-hidden">{{stonetop.vitals.sources.hp}}</span>{{/if}}

			{{#if stonetop.vitals.hpMeter.isDying}}
			{{#with stonetop.railMoves.atZeroHp}}
			<div class="stonetop-conditional stonetop-conditional--dire">
				<ol class="stonetop-move-list">{{> "stonetop.character-move-row" categoryKey="special"
				    categoryLabel=(localize "stonetop.character.moves.specialMoves")}}</ol>
			</div>
			{{/with}}
			{{/if}}

			<div class="stonetop-rail-advancement">
				{{> "stonetop.rail-meter" kind="xp" label=(localize "stonetop.character.attributes.xp") meter=stonetop.vitals.xpTrack
				    valueAction="xp" valueLabel=(localize "stonetop.a11y.xpCurrent")
				    tooltip=(localize "stonetop.character.attributes.desc.xp")
				    tone=(ifThen stonetop.vitals.xpTrack.isReady "full" "")
				    note=(ifThen stonetop.vitals.xpTrack.isReady
				        (ifThen stonetop.vitals.xpTrack.surplus
				            (localize "stonetop.character.attributes.note.readyWithSpare" count=stonetop.vitals.xpTrack.surplus)
				            (localize "stonetop.character.attributes.note.readyToLevel"))
				        "")}}

				{{> "stonetop.level-up-strip"}}

				{{!-- Burn Brightly shares Level Up's threshold and nothing else. Its trigger alone ("have
				      enough XP to Level Up") says the opposite of what it is, so it is labelled as the other
				      choice, on a neutral edge, and open. --}}
				{{#if stonetop.vitals.xpTrack.isReady}}
				{{#with stonetop.railMoves.burnBrightly}}
				<div class="stonetop-conditional stonetop-conditional--spend">
					<p class="stonetop-conditional-label">{{localize "stonetop.character.levelUp.orSpend"}}</p>
					<ol class="stonetop-move-list">{{> "stonetop.character-move-row" categoryKey="special"
					    categoryLabel=(localize "stonetop.character.moves.specialMoves") startOpen=true}}</ol>
				</div>
				{{/with}}
				{{/if}}

				{{!-- A route, not a row: every player does End of Session's six things every session. --}}
				{{#with stonetop.railMoves.endOfSession}}
				<p class="stonetop-rail-route"><button type="button" class="stonetop-goto" data-action="openMoveBySlug"
				        data-view-state data-move-slug="{{slug}}">{{name}}</button></p>
				{{/with}}
			</div>

			{{!-- The reference moves (D8): the basic moves in a group that starts open, the expedition
			      moves in one that starts shut, split by phase. The follower moves are on the Followers
			      tab, and each special move is placed above (D9). --}}
			{{#each stonetop.moves.categories}}
			{{#if (eq key "basic")}}{{> "stonetop.rail-move-group" category=this index=0 open=true}}{{/if}}
			{{#if (eq key "expedition")}}{{> "stonetop.rail-move-group" category=this index=1 open=false}}{{/if}}
			{{/each}}
		</div>

	<div class="stonetop-rail-main character-main">

	{{> "stonetop.character-band"}}

	{{!-- data-action="tab" is core ApplicationV2's built-in action (→ changeTab); context.tabs
	      already carries the per-insert tabs via the sheet's _getTabsConfig override. --}}
	<nav class="sheet-tabs tabs" data-group="primary">
		{{#each tabs}}
		<button type="button" class="item {{this.cssClass}}" data-action="tab" data-group="primary" data-tab="{{this.id}}">{{localize this.label}}</button>
		{{/each}}
		{{> "stonetop.tab-more" tabs=tabs}}
	</nav>

	<section class="sheet-body">
		{{> "stonetop.tab-playbook"}}
		{{#each stonetop.inserts}}{{> "stonetop.tab-insert" insert=this tab=(lookup @root.tabs (concat "insert-" slug))}}{{/each}}
		{{> "stonetop.tab-moves"}}
		{{> "stonetop.tab-possessions"}}
		{{> "stonetop.tab-equipment"}}
		{{> "stonetop.tab-arcana"}}
		{{> "stonetop.tab-followers"}}
		{{> "stonetop.tab-notes"}}
	</section>

	</div>{{!-- /rail-main --}}
	</div>{{!-- /rail-layout --}}

</div>
