<div class="tab moves" data-group="primary" data-tab="moves">
	<section class="sheet-tab">

		{{!-- Roll Mode --}}
		<section class="sheet-resources flexrow">
			<div class="cell cell--roll-mode">
				<label class="cell__title">{{localize "stonetop.rollMode.label"}}</label>
				<div class="stonetop-roll-modes">
					<label>
						<input type="radio" name="stonetop-roll-mode" value="normal"
						       {{#if (eq stonetop.rollMode "normal")}}checked{{/if}}>
						{{localize "stonetop.rollMode.normal"}}
					</label>
					<label>
						<input type="radio" name="stonetop-roll-mode" value="adv"
						       {{#if (eq stonetop.rollMode "adv")}}checked{{/if}}>
						{{localize "stonetop.rollMode.adv"}}
					</label>
					<label>
						<input type="radio" name="stonetop-roll-mode" value="dis"
						       {{#if (eq stonetop.rollMode "dis")}}checked{{/if}}>
						{{localize "stonetop.rollMode.dis"}}
					</label>
				</div>
			</div>
		</section>

		{{#each stonetop.moves.categories}}
		{{#if (eq renderStyle "standard")}}
		{{> "stonetop.move-group" title=label note=note moves=moves categoryKey=key allowAdditional=allowAdditional}}
		{{#if allowAdditional}}
		<button type="button" class="item-control item-create" data-type="move" data-move-type="{{key}}" title="{{localize 'stonetop.character.moves.addMove'}}">
			<i class="fas fa-plus"></i>
		</button>
		{{/if}}
		{{/if}}
		{{/each}}

	</section>
</div>
