{{!-- The Moves tab: a panel for each category of the character's own moves, the playbook's first and
      the moves dropped on last. The rail holds the reference moves, an insert's tab its own, and the
      Followers tab the follower moves, so they are not here. --}}
<div class="tab moves {{tabs.moves.cssClass}}" data-group="primary" data-tab="moves">
	<section class="sheet-tab">
		{{#each stonetop.moves.categories}}
		{{#if (eq renderStyle "standard")}}
		{{> "stonetop.moves-panel" category=this index=@index owedMove=@root.stonetop.levelUp.owedMove}}
		{{/if}}
		{{/each}}
	</section>
</div>
