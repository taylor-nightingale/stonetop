{{!-- The special possessions (D11, as the Moves tab): one panel that rests on what the character has,
      with a door to the playbook's whole list. The playbook's sentence rides the bar while choosing,
      and what is still to pick is said while anything is. --}}
<div class="tab possessions {{tabs.possessions.cssClass}}" data-group="primary" data-tab="possessions">
	<section class="sheet-tab">
	{{#with stonetop.possessions}}
	<section class="stonetop-panel stonetop-possessions-panel" data-disclosure-row data-section="possessions">
		{{> "stonetop.bar" title=(localize "stonetop.character.gear.specialPossessions") index=0 note=pickNote noteWhileOpen=true
		    action="stonetop.section-door" door=door controls=(sectionId @root.sheetIdPrefix "possessions")}}
		{{#if owed}}
		<div class="stonetop-conditional stonetop-conditional--ready stonetop-owing">
			<p class="stonetop-owing-text"><span data-disclosure-shut>{{pickNote}} · </span>{{localize "stonetop.character.gear.stillToPick" count=owed}}</p>
			<button type="button" class="stonetop-owing-choose" data-action="goToTab" data-view-state data-disclosure-shut
			        data-tab="possessions" data-open-sections="possessions">{{localize "stonetop.sheet.section.choose"}}</button>
		</div>
		{{/if}}
		<div class="stonetop-section-rest" data-disclosure-shut>
			<ol class="stonetop-move-list stonetop-possession-rows">
				{{#each items}}{{#if checked}}{{> "stonetop.possession-row" choosing=false}}{{/if}}{{/each}}
			</ol>
		</div>
		<div class="stonetop-section-choose" id="{{sectionId @root.sheetIdPrefix "possessions"}}" hidden>
			<ol class="stonetop-move-list stonetop-possession-rows">
				{{#each items}}{{> "stonetop.possession-row" choosing=true}}{{/each}}
			</ol>
		</div>
	</section>
	{{/with}}
	</section>
</div>
