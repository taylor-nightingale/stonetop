<div class="tab possessions {{tabs.possessions.cssClass}}" data-group="primary" data-tab="possessions">

	{{#if stonetop.possessions}}
	<div class="tab-section tab-section--possessions">
		{{> "stonetop.section-heading" title=(localize "stonetop.character.gear.specialPossessions") note=stonetop.possessions.pickNote}}
		<ol class="stonetop-possession-list">
		{{#each stonetop.possessions.items}}
			<li class="stonetop-item{{#if checked}} is-checked{{/if}}">
				<div class="stonetop-item-header">
					<input type="checkbox" class="stonetop-item-check stonetop-possession-check" data-change-action="possessionCheck"
					       aria-label="{{localize 'stonetop.a11y.possessionTaken'}}"
					       data-slug="{{slug}}"
					       {{#if checked}}checked{{/if}}
					       {{#if disabled}}disabled{{/if}}>
					<strong class="stonetop-item-name">{{rich label}}</strong>
					{{#if preselectedSource}}<span class="stonetop-item-source">{{preselectedSource}}</span>{{/if}}
					{{#if resource}}
					<span class="stonetop-item-resources">
						{{> "stonetop.resource-track" resource=resource btnClass="stonetop-item-resource-check" action="possessionUsePip" possessionSlug=slug}}
					</span>
					{{/if}}
					{{#if removable}}<button type="button" class="stonetop-possession-delete" data-action="deletePossession" data-slug="{{slug}}" data-name="{{label.raw}}" title="{{localize 'stonetop.inventory.removeItem'}} — {{localize 'stonetop.confirm.deleteHint'}}" aria-label="{{localize 'stonetop.inventory.removeItem'}} — {{localize 'stonetop.confirm.deleteHint'}}"><i class="fas fa-trash"></i></button>{{/if}}
				</div>
				{{#if description}}
				<div class="stonetop-item-description">{{rich description}}</div>
				{{/if}}
				{{#if choices}}
				<div class="stonetop-choice-rows" data-possession-slug="{{slug}}">
				{{#each choices.list}}
					{{> "stonetop.choice-row" cgContext="possession" cgGroup=../choices.slug namePrefix=../slug}}
				{{/each}}
				</div>
				{{/if}}
			</li>
		{{/each}}
		</ol>
	</div>
	{{/if}}

</div>
