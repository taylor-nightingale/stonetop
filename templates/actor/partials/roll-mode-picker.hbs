{{!-- A one-of-N choice as a labelled column of radios with a dot-in-ring mark. The roll modes
      themselves are asked by the roll dialog (RollModeDialog); this partial now draws the improvement
      sheet's editors — a section's rule, when a result fires, what the sheet does.

      A <fieldset>, not a bare list: radios that mean one setting are a group, and a group with no
      accessible name is loose words.

      Parameters: `modes` ([{key, labelKey, checked, hasDetail}]), `name` scoping the radio group,
      `legendKey`, `changeAction` for a sheet's change router, and `detail`: a partial drawn under the
      CHECKED option, given `detailContext` — the fields that option asks for sit directly under it,
      so it is plain which choice they belong to. Only under an option whose mode says `hasDetail`:
      one that asks for nothing gets no empty box. --}}
<fieldset class="stonetop-rollmode">
	<legend class="stonetop-rollmode-legend">{{localize (ifThen legendKey legendKey "stonetop.rollMode.label")}}</legend>
	{{#each modes}}
	<label class="stonetop-rollmode-option{{#if checked}} is-checked{{/if}}">
		<input type="radio" class="stonetop-rollmode-input" name="{{../name}}"
		       {{#if ../changeAction}}data-change-action="{{../changeAction}}"{{/if}}
		       value="{{key}}" {{#if checked}}checked{{/if}}>
		<span class="stonetop-rollmode-mark" aria-hidden="true"></span>
		<span class="stonetop-rollmode-label">{{localize labelKey}}</span>
	</label>
	{{#if (and checked hasDetail ../detail)}}
	<div class="stonetop-rollmode-detail">{{> (lookup .. "detail") ../detailContext}}</div>
	{{/if}}
	{{/each}}
</fieldset>
