{{!-- One move row body (shared between the moves tab and the major-arcana card). Context is a
      MoveSnapshot; params: showCheck (render the acquisition checkbox), categoryKey, allowAdditional.
      The caller supplies the <li>/<ol> wrapper. --}}
<div class="stonetop-item-header">
	{{#if showCheck}}
	{{#if (gt selection.max 1)}}
	<span class="stonetop-repeat-checks">
		{{#each (repeatChecks this)}}
		<input type="checkbox" class="stonetop-item-check stonetop-repeat-check"
		       aria-label="{{localize 'stonetop.a11y.trackPip' name=(localize 'stonetop.a11y.moveTaken') position=(inc @index) total=../selection.max}}"
		       data-change-action="moveCheck"
		       data-category-key="{{../categoryKey}}"
		       data-move-slug="{{../slug}}"
		       data-owned-id="{{../ownedId}}"
		       {{#if checked}}checked{{/if}}
		       {{#if disabled}}disabled{{/if}}>
		{{/each}}
	</span>
	{{else}}
	<input type="checkbox" class="stonetop-item-check stonetop-move-check"
	       aria-label="{{localize 'stonetop.a11y.moveTaken'}}"
	       data-change-action="moveCheck"
	       data-category-key="{{categoryKey}}"
	       data-move-slug="{{slug}}"
	       data-owned-id="{{ownedId}}"
	       {{#if (gt selection.value 0)}}checked{{/if}}
	       {{#if (or locked (and (not (gt selection.value 0)) (not selectable)))}}disabled{{/if}}>
	{{/if}}
	{{/if}}
	{{!-- The one place a move icon renders: every surface that shows a move goes through this body,
	      so the moves tab, side-bar, arcanum cards and the seasons tab all match. --}}
	{{#if icon}}<img class="stonetop-move-icon" src="{{icon}}" alt="">{{/if}}
	<strong class="stonetop-item-name">{{name}}</strong>
	{{#if sourceLabel}}<span class="stonetop-item-source">{{sourceLabel}}</span>{{/if}}
	{{!-- Any move that rolls shows its die, ticked or not: the check marks what the character has
	      taken, not what the table is allowed to roll. --}}
	{{#if rollStat}}
	<span class="rollable move-rollable" data-roll="{{rollStat}}" data-mod="">
		<i class="fas fa-dice-d6"></i>
	</span>
	{{/if}}
	<button type="button" class="stonetop-move-chat" data-action="moveToChat" data-move-slug="{{slug}}"
	   title="{{localize 'stonetop.character.moves.sendToChat'}}" aria-label="{{localize 'stonetop.character.moves.sendToChat'}}">
		<i class="fas fa-comment"></i>
	</button>
	{{#if (and (or alwaysShowResource (gt selection.value 0)) resource)}}
	<span class="stonetop-item-resources">
		{{!-- moveSlug is what the pip handler reads; slug is passed explicitly because a partial
		      inherits the caller's context, and an attribute nobody asked for is worse than one
		      that is spelled out. --}}
		{{> "stonetop.resource-track" resource=resource btnClass="stonetop-item-resource-check"
		    action="moveResourcePip" moveSlug=slug slug=slug}}
		{{> "stonetop.resource-input" input=resource.input moveSlug=slug}}
	</span>
	{{/if}}
	{{#if allowAdditional}}
	<button type="button" class="stonetop-other-move-delete" data-action="deleteOtherMove" data-move-slug="{{slug}}" data-name="{{name}}" title="{{localize 'stonetop.character.moves.removeMove'}} — {{localize 'stonetop.confirm.deleteHint'}}" aria-label="{{localize 'stonetop.character.moves.removeMove'}} — {{localize 'stonetop.confirm.deleteHint'}}">
		<i class="fas fa-trash"></i>
	</button>
	{{/if}}
</div>
{{#if requirement}}<div class="stonetop-item-requirement{{#unless requirement.met}} stonetop-item-requirement--unmet{{/unless}}">{{localize "stonetop.character.moves.requires"}}: {{requiresLabel}}{{#unless requirement.met}} ({{localize "stonetop.character.moves.notMet"}}){{/unless}}</div>{{/if}}
<div class="stonetop-item-description">{{rich description}}</div>
{{#if choices}}
<div class="stonetop-move-choices" data-move-slug="{{slug}}">
	{{#each choices.list}}
	{{> "stonetop.choice-row" cgContext="move" cgGroup=../choices.slug namePrefix=../slug}}
	{{/each}}
</div>
{{/if}}
