{{!-- An add/edit/remove list of the strings backing a rating: `resources` (Prosperity) or
      `fortifications` (Defenses). Shared by the steading overview and the steadfast sheet.

      No frame: this list sits under the rating it justifies, and a border round it would cut the
      two apart. The heading rule and the row hairlines are what separate it from its neighbours.
      Params: title, addLabel, attr (the rating slug the list backs), items (array of strings). --}}
<div class="steading-overview-field">
	{{!-- The system's own section heading, so a block on this tab is titled the way every block on
	      the character sheet is. It had a heading of its own that came out SMALLER than the rows
	      underneath it, which is not a heading. --}}
	{{> "stonetop.section-heading" title=title}}
	<div class="steading-attr-list">
		{{#each items}}
			<div class="steading-attr-row">
				{{!-- A textarea, not an input: a resource is a phrase ("Tradesfolk (midwife, potter,
				      publican, smith, tanner)"), and an input scrolls the tail of one out of view
				      sideways with no way to see it but to put the caret back in. One line to start,
				      growing downward as it wraps — the same field the choice rows use. --}}
				<textarea rows="1" class="stonetop-attr-extra stonetop-grow-field" data-change-action="attributeItem" data-attr="{{../attr}}" data-index="{{@index}}"
				          aria-label="{{localize 'stonetop.a11y.ratingExtra'}}">{{this}}</textarea>
				<button class="stonetop-attr-extra-remove stonetop-icon-btn" data-action="removeAttributeItem" type="button" data-attr="{{../attr}}" data-index="{{@index}}" data-name="{{this}}" title="{{localize 'stonetop.steading.lists.removeItem'}}" aria-label="{{localize 'stonetop.steading.lists.removeItem'}}">
					<img src="systems/stonetop/assets/ui/controls/delete-icon.png" alt="">
				</button>
			</div>
		{{/each}}
		{{!-- The list's last row, and it says what it makes. A bare + at the foot of a column named
		      neither the list it joins nor what a row is. --}}
		<button class="stonetop-attr-extra-add stonetop-list-add" data-action="addAttributeItem" type="button" data-attr="{{attr}}" aria-label="{{addLabel}}">
			<img src="systems/stonetop/assets/ui/controls/plus-icon.png" alt=""><span>{{addLabel}}</span>
		</button>
	</div>
</div>
