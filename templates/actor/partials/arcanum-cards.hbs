{{#each items}}
{{#if owned}}
<div class="stonetop-arcanum-card{{#if flipped}} is-flipped{{/if}}" data-slug="{{slug}}">

	{{#if img}}
	<img class="stonetop-arcanum-img" src="{{img}}" alt="{{name}}">
	{{/if}}

	{{#if flipped}}
	{{!-- Back side --}}
	<div class="stonetop-arcanum-header">
		<div class="stonetop-arcanum-header-left">
			<span class="stonetop-arcanum-title">{{rich back.title}}</span>
			{{#if back.item}}{{> "stonetop.outfit-item-row" back.item}}{{/if}}
		</div>
		{{#if back.resource}}
		<div class="stonetop-arcanum-header-resource">
			{{> "stonetop.resource-track" resource=back.resource btnClass="stonetop-arcanum-resource-btn" action="arcanumResourcePip" slug=slug}}
		</div>
		{{/if}}
	</div>
	<div class="stonetop-arcanum-body">
		{{#if (hasText back.description)}}
		<div class="stonetop-arcanum-section">{{rich back.description}}</div>
		{{/if}}
		{{!-- The back is an ordered list of choice groups (spells / moves / followers / consequences). Each
		      row renders its content, ornamental track, and any inline follower/move grant via choice-row. --}}
		{{#each back.choices}}
		<div class="stonetop-arcanum-section" data-cg-group="{{slug}}">
			{{#if title}}<p class="stonetop-arcanum-section-label">{{title}}</p>{{/if}}
			{{#each list}}
			{{> "stonetop.choice-row" cgContext="arcana" cgGroup=../slug}}
			{{/each}}
		</div>
		{{/each}}
	</div>

	{{else}}
	{{!-- Front side --}}
	<div class="stonetop-arcanum-header">
		<div class="stonetop-arcanum-header-left">
			<span class="stonetop-arcanum-title">{{rich front.title}}</span>
			{{#if front.item}}{{> "stonetop.outfit-item-row" front.item}}{{/if}}
			{{#if front.tags}}<span class="stonetop-arcanum-tags">{{front.tags}}</span>{{/if}}
		</div>
	</div>
	<div class="stonetop-arcanum-body">
		{{#if (hasText front.description)}}
		<div class="stonetop-arcanum-section">{{rich front.description}}</div>
		{{/if}}
		{{#if front.unlock.list.length}}
		<div class="stonetop-arcanum-unlock stonetop-arcanum-section">
			{{#each front.unlock.list}}
			{{> "stonetop.choice-row" cgContext="arcana" cgGroup=../front.unlock.slug}}
			{{/each}}
		</div>
		{{/if}}
	</div>
	{{/if}}

	<div class="stonetop-arcanum-footer">
		<button type="button" class="stonetop-arcanum-flip-btn" data-action="flipArcanum"
		        data-slug="{{slug}}" data-flipped="{{flipped}}">
			{{#if flipped}}{{localize "stonetop.arcana.showFront"}}{{else}}{{localize "stonetop.arcana.showBack"}}{{/if}}
		</button>
		<button type="button" class="stonetop-arcanum-delete" data-action="deleteArcanum" data-slug="{{slug}}" data-name="{{name}}"
		        title="{{localize 'stonetop.arcana.removeArcanum'}} — {{localize 'stonetop.confirm.deleteHint'}}">
			<img src="systems/stonetop/assets/ui/controls/delete-icon.png" alt="{{localize 'stonetop.arcana.removeArcanum'}}">
		</button>
	</div>

</div>
{{/if}}
{{/each}}
