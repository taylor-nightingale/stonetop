{{#each items}}
{{#if owned}}
<div class="stonetop-arcanum-card{{#if flipped}} is-flipped{{/if}}" data-slug="{{slug}}">

	{{#if img}}
	<img class="stonetop-arcanum-img" src="{{img}}" alt="{{name}}">
	{{/if}}

	{{!-- Front and back are authored differently but render identically (one ArcanumSideSnapshot each);
	      render the active side by `flipped`. The front's heading is the arcanum's own name, the back's is
	      the mystery's title. Header chrome (title / item / tags / resource) sits above a body that is
	      entirely choice groups — each row's
	      content, ornamental □ track, and inline follower/move grant render through choice-row. The side is
	      passed to the inline partial with the arcanum `slug` merged in (for the header resource track). --}}
	{{#*inline "arcanum-side"}}
	<div class="stonetop-arcanum-header">
		<div class="stonetop-arcanum-header-left">
			<span class="stonetop-arcanum-title">{{rich title}}</span>
			{{#if item}}{{> "stonetop.outfit-item-row" item}}{{/if}}
			{{#if tags.length}}<span class="stonetop-arcanum-tags">{{> "stonetop.tag-list" tags=tags}}</span>{{/if}}
		</div>
		{{#if resource}}
		<div class="stonetop-arcanum-header-resource">
			{{> "stonetop.resource-track" resource=resource btnClass="stonetop-arcanum-resource-btn" action="arcanumResourcePip" slug=slug}}
		</div>
		{{/if}}
	</div>
	<div class="stonetop-arcanum-body">
		{{#each choices}}
		<div class="stonetop-arcanum-section" data-cg-group="{{slug}}">
			{{#if title}}<p class="stonetop-arcanum-section-label">{{title}}</p>{{/if}}
			{{#each list}}
			{{> "stonetop.choice-row" cgContext="arcana" cgGroup=../slug}}
			{{/each}}
		</div>
		{{/each}}
	</div>
	{{/inline}}
	{{#if flipped}}{{> arcanum-side back slug=slug}}{{else}}{{> arcanum-side front slug=slug}}{{/if}}

	<div class="stonetop-arcanum-footer">
		<button type="button" class="stonetop-arcanum-flip-btn" data-action="flipArcanum"
		        data-slug="{{slug}}" data-flipped="{{flipped}}">
			{{#if flipped}}{{localize "stonetop.arcana.showFront"}}{{else}}{{localize "stonetop.arcana.showBack"}}{{/if}}
		</button>
		<button type="button" class="stonetop-arcanum-delete" data-action="deleteArcanum" data-slug="{{slug}}" data-name="{{name}}"
		        title="{{localize 'stonetop.arcana.removeArcanum'}} — {{localize 'stonetop.confirm.deleteHint'}}" aria-label="{{localize 'stonetop.arcana.removeArcanum'}} — {{localize 'stonetop.confirm.deleteHint'}}">
			<img src="systems/stonetop/assets/ui/controls/delete-icon.png" alt="{{localize 'stonetop.arcana.removeArcanum'}}">
		</button>
	</div>

</div>
{{/if}}
{{/each}}
