{{!-- HP, Armor and Damage: what you can take, what you deflect, what you deal.

      No heading. The three tiles name themselves with their own label chips, the band they sit in
      is self-evident, and the region already carries one heading ("Stats") — a second beside it
      would put two heading idioms in one band, which is what made the first attempt's column read
      as two sheets stacked.

      XP and Level are NOT here. They are consulted once a session, not mid-blow, so they live in
      the rail under Advancement; these three are consulted every time something lands.

      Each value states its own provenance, and states it to EVERYONE. It used to live only in a
      `data-tooltip`, which is pointer-only and invisible to assistive tech; then a printed note
      beside the value, which said it out loud but cost the band a line under every tile — a third of
      this row's height for three words, on the one block of the sheet that cannot make more room.

      Now the hover's own sentence is the one assistive tech gets, tied to the field it describes by
      `aria-describedby`. It is the LONG form, not the note's one word, so this reads better than the
      printed note did and takes no height at all. `sources` and `notes` are still two strings for
      the two lengths; nothing on this sheet prints the short one any more. --}}
<div class="stonetop-resource-row stonetop-resource-row--vitals">

	<div class="stonetop-vital">
		<div class="stonetop-resource stonetop-resource--wide">
			<span class="stonetop-resource__label"
			      data-tooltip="{{stonetop.vitals.sources.hp}}" data-tooltip-direction="UP">HP</span>
			<div class="stonetop-resource__split">
				<span class="stonetop-stepper">
					<input class="stonetop-resource__input stonetop-char-hp stonetop-step" type="number" data-change-action="hp"
					       aria-label="{{localize 'stonetop.a11y.hpCurrent'}}"
					       value="{{stonetop.vitals.hp.value}}" min="0">
					{{> "stonetop.stepper-buttons"}}
				</span>
				<span>/</span>
				<span class="stonetop-stepper">
					<input class="stonetop-resource__max stonetop-char-max-hp stonetop-step" type="number" data-change-action="maxHp"
					       aria-label="{{localize 'stonetop.a11y.hpMax'}}"
					       {{#if (hasText stonetop.vitals.sources.hp)}}aria-describedby="{{sheetIdPrefix}}-vital-hp-source"{{/if}}
					       value="{{stonetop.vitals.hp.max}}" min="0">
					{{> "stonetop.stepper-buttons"}}
				</span>
			</div>
		</div>
		{{#if (hasText stonetop.vitals.sources.hp)}}
		<span id="{{sheetIdPrefix}}-vital-hp-source" class="stonetop-visually-hidden">{{stonetop.vitals.sources.hp}}</span>
		{{/if}}
	</div>

	<div class="stonetop-vital">
		<div class="stonetop-resource stonetop-resource--small">
			<span class="stonetop-resource__label"
			      data-tooltip="{{stonetop.vitals.sources.armor}}" data-tooltip-direction="UP">{{localize "stonetop.character.attributes.armor"}}</span>
			<span class="stonetop-stepper">
				<input class="stonetop-resource__input stonetop-char-armor stonetop-step" type="number" data-change-action="armor"
				       aria-label="{{localize 'stonetop.character.attributes.armor'}}"
				       {{#if (hasText stonetop.vitals.sources.armor)}}aria-describedby="{{sheetIdPrefix}}-vital-armor-source"{{/if}}
				       value="{{stonetop.vitals.armor}}" min="0">
				{{> "stonetop.stepper-buttons"}}
			</span>
		</div>
		{{#if (hasText stonetop.vitals.sources.armor)}}
		<span id="{{sheetIdPrefix}}-vital-armor-source" class="stonetop-visually-hidden">{{stonetop.vitals.sources.armor}}</span>
		{{/if}}
	</div>

	<div class="stonetop-vital">
		<div class="stonetop-resource stonetop-resource--small">
			<button class="stonetop-resource__label stonetop-damage-roll rollable" type="button"
			        data-roll="damage"
			        data-tooltip="{{stonetop.vitals.sources.damage}}" data-tooltip-direction="UP">{{localize "stonetop.character.attributes.damage"}}</button>
			<input class="stonetop-resource__input stonetop-char-damage" type="text" data-change-action="damage"
			       aria-label="{{localize 'stonetop.a11y.damageDie'}}"
			       {{#if (hasText stonetop.vitals.sources.damage)}}aria-describedby="{{sheetIdPrefix}}-vital-damage-source"{{/if}}
			       value="{{stonetop.vitals.damage.value}}">
		</div>
		{{#if (hasText stonetop.vitals.sources.damage)}}
		<span id="{{sheetIdPrefix}}-vital-damage-source" class="stonetop-visually-hidden">{{stonetop.vitals.sources.damage}}</span>
		{{/if}}
	</div>

</div>
