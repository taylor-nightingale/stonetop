<div class="tab followers {{tabs.followers.cssClass}}" data-group="primary" data-tab="followers">

	<div class="stonetop-advice-toolbar">
		{{> "stonetop.advice-button" variant="labelled" topic="followers"}}
	</div>

	{{!-- D8: the follower moves once, above the followers they are about — not once per follower, as
	      paper has to print them — and only while there is someone to order. --}}
	{{#if stonetop.followers.tab.length}}
	{{#each stonetop.moves.categories}}
	{{#if (eq key "follower")}}
	<section class="stonetop-panel stonetop-move-panel">
		{{> "stonetop.bar" title=label index=0}}
		{{> "stonetop.move-list" moves=moves categoryKey=key categoryLabel=label chat=true}}
	</section>
	{{/if}}
	{{/each}}
	{{/if}}

	{{#unless stonetop.followers.tab.length}}
	<p class="stonetop-followers-empty">{{localize "stonetop.followers.empty"}}</p>
	{{/unless}}

	<div class="stonetop-followers-grid">
	{{#each stonetop.followers.tabCards}}
	{{> "stonetop.follower-card" this showDelete=true}}
	{{/each}}
	</div>

	<button type="button" class="stonetop-follower-add" data-action="addFollower">
		<i class="fas fa-plus"></i> {{localize "stonetop.followers.add"}}
	</button>

</div>
