{{!-- One outfit-item row (shared by the inventory tab, follower inventory, and arcanum cards).
      Context = an OutfitItemSnapshot-like { slug, name, weight, tags, note, checked, resource,
      isCustom, ownedId }. The weight diamonds + resource toggle the character's inventory keyed by
      `slug`. --}}
<div class="stonetop-inv-item{{#if checked}} is-checked{{/if}}">
	<span class="stonetop-inv-diamonds">
		{{#each (times weight)}}
		<input type="checkbox" class="stonetop-inventory-item-check stonetop-inv-diamond" data-change-action="inventoryItemCheck"
		       aria-label="{{localize 'stonetop.a11y.carriedDiamond'}}"
		       data-slug="{{../slug}}" {{#if ../checked}}checked{{/if}}>
		{{/each}}
	</span>
	{{!-- The book prints an item as `Spear, iron (close, thrown, x piercing)`: ONE parenthetical
	      holding the italic tags and then the roman note, not a group each. The two branches differ
	      only in whether the tags come first — deliberately spelled out rather than adding a generic
	      `or` helper for one row. --}}
	{{!-- Each branch opens with its own literal space: the separator belongs to the parenthetical, so
	      an item with neither tags nor note ends cleanly at its name. --}}
	<span class="stonetop-inv-label">{{name}}
		{{~#if tags.length~}}
			<span class="stonetop-inv-parens"> ({{> "stonetop.tag-list" tags=tags}}{{#if (hasText note)}}, <span class="stonetop-inv-note">{{rich note}}</span>{{/if}})</span>
		{{~else if (hasText note)~}}
			<span class="stonetop-inv-parens"> (<span class="stonetop-inv-note">{{rich note}}</span>)</span>
		{{~/if~}}
	</span>
	{{#if resource}}
	<span class="stonetop-inv-resources">
		{{> "stonetop.resource-track" resource=resource btnClass="stonetop-inv-resource-btn stonetop-inventory-resource-btn" action="inventoryResourcePip" slug=slug}}
	</span>
	{{/if}}
	{{#if isCustom}}
	<button type="button" class="stonetop-inv-delete" data-action="deleteInventoryItem" data-owned-id="{{ownedId}}" data-name="{{name}}" title="{{localize 'stonetop.inventory.removeItem'}} — {{localize 'stonetop.confirm.deleteHint'}}" aria-label="{{localize 'stonetop.inventory.removeItem'}} — {{localize 'stonetop.confirm.deleteHint'}}"><i class="fas fa-times"></i></button>
	{{/if}}
</div>
