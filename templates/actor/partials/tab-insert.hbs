<div class="tab insert insert-{{insert.slug}} {{tab.cssClass}}{{#if locked}} is-locked{{/if}}"
     data-group="primary" data-tab="insert-{{insert.slug}}"
     data-insert-item-id="{{insert.id}}">
	<section class="sheet-tab">
		<div class="stonetop-insert-header">
			{{#if insert.img}}<img class="stonetop-insert-icon" src="{{insert.img}}" alt="{{insert.name}}">{{/if}}
			<div class="stonetop-insert-heading">
				<h3 class="stonetop-insert-name">{{insert.name}}</h3>
				{{#if insert.description.raw}}
				<div class="stonetop-insert-description">{{rich insert.description}}</div>
				{{/if}}
			</div>
			{{!-- One lock per insert, keyed by slug: locking Invocations must not lock the Ghost tab.
			      Both controls sit in one row at the head's right, in flow — see .stonetop-insert-actions. --}}
			<div class="stonetop-insert-actions">
			{{#if locked}}
			{{> "stonetop.tab-toolbar-toggle" flag=viewFlag icon="fa-lock" active=true
			    label=(localize "stonetop.sheet.lock.unlock")
			    title=(localize "stonetop.sheet.lock.unlockHint")}}
			{{else}}
			{{> "stonetop.tab-toolbar-toggle" flag=viewFlag icon="fa-lock-open"
			    label=(localize "stonetop.sheet.lock.lock")
			    title=(localize "stonetop.sheet.lock.lockHint")}}
			{{/if}}
			<button type="button" class="stonetop-insert-remove" data-action="deleteInsert"
			        data-insert-item-id="{{insert.id}}" data-name="{{insert.name}}"
			        title="{{localize 'stonetop.insert.remove'}} — {{localize 'stonetop.confirm.deleteHint'}}">
				<img src="systems/stonetop/assets/ui/controls/delete-icon.png" alt="{{localize 'stonetop.insert.remove'}}">
			</button>
			</div>
		</div>
		<div class="stonetop-playbook-columns">
			{{#if insert.instinctGroup}}
			{{> "stonetop.instinct-section"
			    instinctSelected=insert.instinctSelected
			    instinctGroup=insert.instinctGroup
			    namePrefix=insert.id
			    cgContext="insert-pick"
			    locked=locked}}
			{{/if}}
			{{> "stonetop.choice-section" groups=insert.choices cgContext="insert" locked=locked}}
		</div>
	</section>
</div>
