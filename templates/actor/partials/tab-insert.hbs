{{!-- An insert's tab (D12): the whole insert, as the book prints it on one card. Its head — icon,
      name, how it arrived, and Remove (Undying's 6- trades a Revenant for a Ghost; a purpose fulfilled
      passes you through the Last Door) — then its moves, then its instinct and its sections, drawn as
      the Playbook tab's are and split across the same two fixed columns. Consequences are spent from
      inside the insert's moves, so the two are read together, here. No lock: each section is its own
      door (D11). Params: `insert` (InsertSnapshot), `tab`. --}}
<div class="tab insert insert-{{insert.slug}} {{tab.cssClass}}"
     data-group="primary" data-tab="insert-{{insert.slug}}"
     data-insert-item-id="{{insert.id}}">
	<section class="sheet-tab">
		<div class="stonetop-insert-header">
			{{#if insert.img}}<img class="stonetop-insert-icon" src="{{insert.img}}" alt="{{insert.name}}">{{/if}}
			<div class="stonetop-insert-heading">
				<h3 class="stonetop-insert-name">{{insert.name}}</h3>
				{{#if insert.description.raw}}
				<div class="stonetop-insert-description">{{rich insert.description}}</div>
				{{/if}}
			</div>
			<div class="stonetop-insert-actions">
			<button type="button" class="stonetop-insert-remove" data-action="deleteInsert"
			        data-insert-item-id="{{insert.id}}" data-name="{{insert.name}}"
			        title="{{localize 'stonetop.insert.remove'}} — {{localize 'stonetop.confirm.deleteHint'}}" aria-label="{{localize 'stonetop.insert.remove'}} — {{localize 'stonetop.confirm.deleteHint'}}">
				<img src="systems/stonetop/assets/ui/controls/delete-icon.png" alt="{{localize 'stonetop.insert.remove'}}">
			</button>
			</div>
		</div>
		{{#if insert.moves.length}}
		<section class="stonetop-panel stonetop-insert-moves">
			{{> "stonetop.bar" title=(localize "stonetop.character.moves.insertMoves" name=insert.name) index=0}}
			{{> "stonetop.move-list" moves=insert.moves categoryKey=(concat "insert-" insert.slug)
			    categoryLabel=insert.name chat=true}}
		</section>
		{{/if}}
		{{#if insert.sections.split}}
		<div class="stonetop-section-columns">
			<div class="stonetop-section-column">
				{{#each insert.sections.left}}{{> "stonetop.insert-section" insert=../insert index=(add 1 @index)}}{{/each}}
			</div>
			<div class="stonetop-section-column">
				{{#each insert.sections.right}}{{> "stonetop.insert-section" insert=../insert index=(add (add 1 ../insert.sections.left.length) @index)}}{{/each}}
			</div>
		</div>
		{{else}}
		{{#each insert.sections.left}}{{> "stonetop.insert-section" insert=../insert index=1}}{{/each}}
		{{/if}}
	</section>
</div>
