<ul class="stats-list flexrow">
	{{#each stats}}
	<li class="stat flexcol cell--stats" data-stat="{{@key}}">
		<input class="stat-value" type="number"
		       name="system.stats.{{@key}}.value"
		       value="{{value}}"
		       min="-3" max="3"
		       {{#unless ../editable}}disabled{{/unless}}>
		<label class="stat-label">{{name}}</label>
		<span class="rollable stat-rollable" data-roll="{{@key}}">
			<i class="fas fa-dice-d6"></i>
		</span>
	</li>
	{{/each}}
</ul>
