{{!-- A group of the steading's moves in its rail — the homefront moves, the Seasons Change moves — as
      a panel whose bar opens and shuts it, like the character's rail groups. The template says it
      starts open; what the reader changes is remembered per sheet (OpenDisclosures). The rows are the
      steading's own (move-row.hbs): they carry the roll reminders and the text resources the
      character's row does not. Params: `group` (MoveCategorySnapshot), `index` (its bar's place). --}}
<section class="stonetop-panel stonetop-move-panel is-open" data-disclosure-row>
	{{> "stonetop.bar" title=group.label index=index note=group.note action="stonetop.bar-toggle"
	    controls=(movesPanelId @root.sheetIdPrefix group.key) open=true
	    labelShow=(localize "stonetop.character.moves.showPanel" name=group.label)
	    labelHide=(localize "stonetop.character.moves.hidePanel" name=group.label)}}
	<div class="stonetop-panel-body" id="{{movesPanelId @root.sheetIdPrefix group.key}}">
		<ol class="steading-move-list">
		{{#each group.moves}}
			{{> "stonetop.move-row" categoryKey=../group.key alwaysShowResource=true disclosure=true}}
		{{/each}}
		</ol>
	</div>
</section>
