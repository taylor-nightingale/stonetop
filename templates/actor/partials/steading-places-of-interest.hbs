{{!-- The Places of Interest panel — a lettered (A, B, C…) list of place-name inputs plus an add
      button. Shared by the steading notes tab and the steadfast sheet.
      Params: places (array of {key, index, value, docLink}); linkHint (steading only — shows the
      drag-to-link hint, since only the steading sheet wires the document-link drop). --}}
<div class="steading-notes-field steading-panel-frame">
	{{> "stonetop.panel-frame"}}
	<h2>Places of Interest</h2>
	<div class="stonetop-places-list">
		{{#each places}}
			<div class="stonetop-places-row" data-index="{{index}}" title="{{localize 'stonetop.steading.linkDropTitle'}}">
				<span class="stonetop-place-key">{{key}}.</span>
				<input type="text" class="stonetop-place-field" data-change-action="placeField" data-index="{{index}}" value="{{value}}">
				{{#if docLink}}
					<span class="steading-doc-link">
						{{rich docLink}}
						<button class="stonetop-place-unlink" data-action="unlinkPlace" type="button" data-index="{{index}}" title="{{localize 'stonetop.steading.unlink'}}" aria-label="{{localize 'stonetop.steading.unlink'}}">✕</button>
					</span>
				{{/if}}
			</div>
		{{/each}}
	</div>
	<button type="button" class="stonetop-place-add stonetop-icon-btn" data-action="addPlace" title="Add place" aria-label="Add place">
		<img src="systems/stonetop/assets/ui/controls/plus-icon.png" alt="">
	</button>
	{{#if linkHint}}<p class="steading-link-hint">{{localize "stonetop.steading.linkHint"}}</p>{{/if}}
</div>
