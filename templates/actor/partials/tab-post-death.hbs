<div class="tab post-death" data-group="primary" data-tab="post-death">
	<section class="sheet-tab">

		<div class="stonetop-pdi-header">
			<h3 class="stonetop-pdi-name">{{stonetop.postDeathInsert.name}}</h3>
			<button type="button" class="stonetop-pdi-remove">
				{{localize "stonetop.postDeath.removeInsert"}}
			</button>
		</div>

		{{#if stonetop.postDeathInsert.description}}
		<div class="stonetop-pdi-description">
			{{{stonetop.postDeathInsert.description}}}
		</div>
		{{/if}}

		<div class="stonetop-details-columns">

		{{! Lore sections: Terrible Purpose, Consequences, etc. }}
		<div data-pdi="lore">
			{{> "stonetop.choice-section" groups=stonetop.postDeathInsert.lore cgContext="pdi-lore"}}
		</div>

		{{! Instinct }}
		{{#if stonetop.postDeathInsert.instinct.group}}
		<div class="details-section">
			{{> "stonetop.section-heading"
			    title=(localize "stonetop.postDeath.instinct")
			    note=(localize "stonetop.character.selection.chooseOne")}}
			<div class="stonetop-instinct-options">
				{{#each stonetop.postDeathInsert.instinct.group.list}}
				{{> "stonetop.choice-row" radio=true namePrefix="stonetop-pdi-instinct" cgContext="pdi-instinct"}}
				{{/each}}
			</div>
		</div>
		{{/if}}

		</div>

	</section>
</div>
