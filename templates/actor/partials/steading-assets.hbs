{{!-- The Assets panel — the general `items` list — plus a framed Coinage panel below it, grouped one
      block per currency (purses/handfuls/coins). Shared by the steading overview and the steadfast sheet.
      Params: items (array of strings), coinage (array of {title, label, purses, handfuls, coins}). --}}
<div class="steading-overview-field steading-panel-frame">
	{{> "stonetop.panel-frame"}}
	<h2>Assets</h2>
	<div class="steading-attr-list">
		{{#each items}}
			<div class="steading-attr-row">
				<input type="text" class="stonetop-asset-item" data-change-action="assetItem" data-index="{{@index}}" value="{{this}}"
				       aria-label="{{localize 'stonetop.a11y.assetItem'}}">
				<button class="stonetop-asset-item-remove stonetop-icon-btn" data-action="removeAssetItem" type="button" data-index="{{@index}}" data-name="{{this}}" title="Remove" aria-label="Remove">
					<img src="systems/stonetop/assets/ui/controls/delete-icon.png" alt="">
				</button>
			</div>
		{{/each}}
		<button class="stonetop-asset-item-add stonetop-icon-btn" data-action="addAssetItem" type="button" title="Add" aria-label="Add">
			<img src="systems/stonetop/assets/ui/controls/plus-icon.png" alt="">
		</button>
	</div>
</div>

<div class="steading-coinage steading-panel-frame">
	{{> "stonetop.panel-frame"}}
	{{#each coinage}}
		<div class="steading-coinage-currency">
			<span class="steading-coinage-name">{{label}}</span>
			<div class="steading-coinage-fields">
				<label class="steading-coinage-field">
					<span>Purses</span>
					<span class="stonetop-stepper">
						<input type="number" class="stonetop-coinage-input stonetop-coinage-purses stonetop-step" data-change-action="coinagePurses" min="0"
						       data-title="{{title}}" value="{{purses}}">
						{{> "stonetop.stepper-buttons"}}
					</span>
				</label>
				<label class="steading-coinage-field">
					<span>Handfuls</span>
					<span class="stonetop-stepper">
						<input type="number" class="stonetop-coinage-input stonetop-coinage-handfuls stonetop-step" data-change-action="coinageHandfuls" min="0"
						       data-title="{{title}}" value="{{handfuls}}">
						{{> "stonetop.stepper-buttons"}}
					</span>
				</label>
				<label class="steading-coinage-field">
					<span>Coins</span>
					<span class="stonetop-stepper">
						<input type="number" class="stonetop-coinage-input stonetop-coinage-coins stonetop-step" data-change-action="coinageCoins" min="0"
						       data-title="{{title}}" value="{{coins}}">
						{{> "stonetop.stepper-buttons"}}
					</span>
				</label>
			</div>
		</div>
	{{/each}}
</div>
