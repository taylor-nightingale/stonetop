{{!-- Why a move might not roll a flat 2d6, one line per source. Context: a RollModeNotes, passed as
      context rather than hash params so its `all` getter survives. Drawn on the move's row and in the
      roll dialog — see move-item.hbs for why it reads as a reminder and never as a state. --}}
<ul class="stonetop-move-rollnotes">
	{{#each all}}
	<li class="stonetop-move-rollnote">
		<span class="stonetop-move-rollnote-verdict">{{localize verdictKey source=source mode=(localize modeKey)}}</span>
		{{#if clause}}<span class="stonetop-move-rollnote-clause">{{rich clause}}</span>{{/if}}
	</li>
	{{/each}}
</ul>
