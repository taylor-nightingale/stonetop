{{!-- Shared outfit rendering for a single inventory column. Params:
       sections   — OutfitSection[] (each {runs, note})
       addColumn  — when set, render the "+ add item" button with this data-column (omit for read-only)
       addLabel   — localization key for that button (defaults to the load column's wording)
       addKey     — which inventory and column the button adds to (an AdderPlace key); the outfit
                    adder is drawn under the button whose key is the one open
       square     — mark rows with a single □ (the small-items column) instead of their weight in ◇
     Item checkboxes carry data-slug = item slug (same for character + follower); the follower path is
     distinguished by the enclosing .stonetop-follower-inventory[data-slug] wrapper, so the handlers
     branch without per-element follower attributes.
     A run knows whether it is set two-across and a section knows the prose printed under it, because
     the inventory page says both (see InventoryPage) — nothing here re-derives either from the rows. --}}
{{#each sections}}
{{#unless @first}}<div class="stonetop-inv-divider" aria-hidden="true"></div>{{/unless}}
{{#each runs}}
{{#if isGrid}}
<div class="stonetop-inv-twocol-grid">
	{{#each items}}
	{{> "stonetop.outfit-item-row" square=../../../square}}
	{{/each}}
</div>
{{else}}
{{#each items}}
{{> "stonetop.outfit-item-row" square=../../../square}}
{{/each}}
{{/if}}
{{/each}}
{{#if note}}<p class="stonetop-inv-section-note">{{{note}}}</p>{{/if}}
{{/each}}
{{#if addColumn}}
<div class="stonetop-inv-add">
	<button type="button" class="stonetop-inv-add-btn" data-action="addInventoryItem" data-column="{{addColumn}}"
	        {{#if (and @root.outfitAdder (eq @root.outfitAdder.key addKey))}}aria-expanded="true" aria-controls="{{@root.sheetIdPrefix}}-outfit-adder"{{else}}aria-expanded="false"{{/if}}>
		<i class="fas fa-plus"></i> {{#if addLabel}}{{localize addLabel}}{{else}}{{localize "stonetop.inventory.addItem"}}{{/if}}
	</button>
	{{#if (and @root.outfitAdder (eq @root.outfitAdder.key addKey))}}{{> "stonetop.outfit-item-adder" adder=@root.outfitAdder}}{{/if}}
</div>
{{/if}}
