{{!-- "Let Spring Break Forth" (Book I, p.30) — the last beat of session zero, on the steading
      because it turns on the Seasons Change move and the table's shared notes. Advisory only:
      nothing here changes a rating, it records what the table decided.
      Steps reuse the introductions section's numbered-step component: same session-zero beat,
      same look. Params: spring (FirstSessionSnapshot). --}}
<section class="steading-spring steading-panel-frame">
	{{> "stonetop.panel-frame"}}

	{{!-- The title carries the audience badge in both states: steading.hbs only renders this
	      section for a GM, and the badge says so rather than leaving them to wonder. --}}
	<h2 class="steading-spring-title">
		{{localize "stonetop.steading.spring.title"}}
		<span class="steading-spring-gm-only">{{localize "stonetop.steading.spring.gmOnly"}}</span>
	</h2>

	{{#if spring.done}}
		<button type="button" class="steading-spring-reopen">{{localize "stonetop.steading.spring.reopen"}}</button>
	{{else}}
		<p class="steading-spring-preamble">{{{localize "stonetop.steading.spring.preamble"}}}</p>

		<div class="stonetop-intro-step">
			<span class="stonetop-intro-step-num">1</span>
			<p>{{{localize "stonetop.steading.spring.hopefulLabel"}}}</p>
			<input type="text" class="steading-spring-hopeful"
			       value="{{spring.hopeful}}"
			       placeholder="{{localize 'stonetop.steading.spring.hopefulPlaceholder'}}">
		</div>

		<div class="stonetop-intro-step">
			<span class="stonetop-intro-step-num">2</span>
			<p>{{{localize "stonetop.steading.spring.rollLabel"}}}</p>
			{{#if spring.hasSpringMove}}
				{{!-- Reuses the sheet's moveToChat action: posting a move's text mutates nothing,
				      so it stays available on a non-editable sheet like every other move card. --}}
				<button type="button" class="steading-spring-post-move" data-view-state
				        data-action="moveToChat" data-move-slug="seasons-change-spring">
					{{localize "stonetop.steading.spring.rollButton"}}
				</button>
			{{/if}}
		</div>

		<div class="stonetop-intro-step">
			<span class="stonetop-intro-step-num">3</span>
			<ul class="steading-spring-omens">
				<li><span class="steading-spring-omen-tier">10+</span><span>{{{localize "stonetop.steading.spring.omenSuccess"}}}</span></li>
				<li><span class="steading-spring-omen-tier">7-9</span><span>{{{localize "stonetop.steading.spring.omenPartial"}}}</span></li>
				<li><span class="steading-spring-omen-tier">6-</span><span>{{{localize "stonetop.steading.spring.omenFailure"}}}</span></li>
			</ul>

			<p class="steading-spring-gains-title">
				{{localize "stonetop.steading.spring.gainsTitle"}}
				<span class="steading-spring-hint">{{localize "stonetop.steading.spring.gainsHint"}}</span>
			</p>
			{{!-- An ordinary choice group — a "pick 1" that releases the previous pick, persisted
			      through the steading's choice values. --}}
			<div class="steading-spring-gains">
				{{#with spring.gains}}{{> "stonetop.choice-group" cgContext="steading"}}{{/with}}
			</div>

			{{!-- Wrapping label rather than for/id: two steading sheets can be open at once, and a
			      duplicated id would point both fields' labels at the same textarea. --}}
			<label>
				<span class="steading-spring-hook-label">{{localize "stonetop.steading.spring.hookLabel"}}</span>
				<textarea class="steading-spring-hook" rows="2"
				          placeholder="{{localize 'stonetop.steading.spring.hookPlaceholder'}}">{{spring.hook}}</textarea>
			</label>
		</div>

		<div class="stonetop-intro-step">
			<span class="stonetop-intro-step-num">4</span>
			<p>{{{localize "stonetop.steading.spring.excitesPreamble"}}}</p>
			{{#if spring.excites.length}}
				<ul class="steading-spring-excites">
					{{#each spring.excites}}
						<li class="steading-spring-excites-row">
							<label>
								<span class="steading-spring-excites-prompt">{{name}}</span>
								<textarea class="steading-spring-excites-answer" rows="2" data-actor-id="{{actorId}}"
								          placeholder="{{localize 'stonetop.steading.spring.excitesPlaceholder'}}">{{answer}}</textarea>
							</label>
						</li>
					{{/each}}
				</ul>
			{{else}}
				<p class="steading-spring-empty">{{localize "stonetop.steading.spring.excitesEmpty"}}</p>
			{{/if}}
		</div>

		<p class="steading-spring-wrap-up">{{{localize "stonetop.steading.spring.wrapUp"}}}</p>

		<button type="button" class="steading-spring-done">{{localize "stonetop.steading.spring.done"}}</button>
	{{/if}}
</section>
