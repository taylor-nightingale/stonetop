<div class="tab equipment {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory">

	{{#if stonetop.outfit}}

	{{!-- Outfit header, with the steading's Prosperity gear table alongside it --}}
	<div class="stonetop-outfit-headers">
		<div class="stonetop-outfit-header">
			{{!-- The book's own figure for these rules: the pack-laden adventurer printed beside them
			      on p. 86. It floats inside this panel, so the load lines set around it. Decorative —
			      alt="" and aria-hidden — and CSS drops it once the panel is too narrow to spare the
			      width. Its file comes from the gitignored art store, so a world that has not
			      installed the artwork simply shows nothing (see HideBrokenImages.js). --}}
			<img class="stonetop-outfit-art" src="stonetop-art/book-one/outfitting.png" alt="" aria-hidden="true">
			<p class="stonetop-outfit-heading">{{{localize "stonetop.inventory.outfit.headingBefore"}}}<button type="button"
					class="stonetop-move-link" data-action="openMoveBySlug" data-move-slug="outfit"
					title="{{localize 'stonetop.character.moves.open'}}"><em><strong>{{localize "stonetop.inventory.outfit.moveName"}}</strong></em></button>{{{localize "stonetop.inventory.outfit.headingAfter"}}}</p>
			{{!-- The rule text runs straight into the three load lines; the count rides the line the
			      marks land in, and the reset tucks into the panel corner, so neither breaks the read. --}}
			<button type="button" class="stonetop-icon-btn stonetop-outfit-reset" data-action="resetOutfit"
			        data-tooltip="{{localize 'stonetop.inventory.outfit.resetHint'}}" data-tooltip-direction="UP"
			        aria-label="{{localize 'stonetop.inventory.outfit.reset'}}">
				<i class="fas fa-rotate-left"></i>
			</button>
			{{#with stonetop.outfit.load}}
			<ul class="stonetop-outfit-loads">
				{{#each options}}
				<li>
					<label class="stonetop-outfit-load-label{{#if active}} is-checked{{/if}}">
						<input type="radio" class="stonetop-outfit-load-radio" name="stonetop-load-level"
						       value="{{slug}}" {{#if active}}checked{{/if}}>
						<span>{{{note}}}</span>
					</label>
					{{#if active}}
					<span class="stonetop-outfit-marked{{#if ../overCapacity}} is-over{{/if}}"
					      data-tooltip="{{localize 'stonetop.inventory.outfit.markedHint'}}" data-tooltip-direction="UP">{{#if ../overCapacity}}<i class="fas fa-triangle-exclamation"></i> {{/if}}— {{localize "stonetop.inventory.outfit.marked" count=../markedWeight}}{{#if ../overCapacity}} {{localize "stonetop.inventory.outfit.markedOver" max=../capacity}}{{/if}}</span>
					{{/if}}
				</li>
				{{/each}}
			</ul>
			{{/with}}
		</div>

		{{#with stonetop.outfit.prosperity}}
		<div class="stonetop-prosperity-panel"
		     {{#if lacking}}data-tooltip="{{localize "stonetop.inventory.prosperityLackingNote"}}" data-tooltip-direction="UP"{{/if}}>
			<p class="stonetop-prosperity-title">
				{{steadingName}} {{localize "stonetop.inventory.prosperity"}}{{#if lacking}}
				<em class="stonetop-prosperity-lacking">{{localize "stonetop.inventory.prosperityLacking"}}</em>{{/if}}
			</p>
			<ul class="stonetop-prosperity-rows">
				{{#each rows}}
				<li class="stonetop-prosperity-row{{#if current}} is-current{{/if}}">
					<span class="stonetop-prosperity-value">{{label}}</span>
					<span class="stonetop-prosperity-note">{{{note}}}</span>
				</li>
				{{/each}}
			</ul>
		</div>
		{{/with}}
	</div>

	<section class="stonetop-inventory">

		{{!-- Regular items (left column) --}}
		<div class="stonetop-inventory-regular">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.regularItems")}}
			<div class="stonetop-inv-divider" aria-hidden="true"></div>
			{{!-- Regular pool --}}
			<div class="stonetop-supplies-pool">
				<span class="stonetop-supplies-pool-label"><strong>{{localize "stonetop.inventory.regularUndefinedPoolLabel"}}</strong></span>
				<span class="stonetop-supplies-pool-diamonds">
					{{#each (poolGroups stonetop.outfit.regularPool)}}
					{{#unless @first}}<span class="stonetop-supplies-pool-gap"></span>{{/unless}}
					{{#each this}}
					<input type="checkbox"
					       class="stonetop-inv-diamond stonetop-regular-pool-btn{{#if checked}} is-checked{{/if}}"
					       aria-label="{{localize 'stonetop.a11y.supplies' position=(inc index)}}"
					       data-change-action="regularPool"
					       data-index="{{index}}"
					       {{#if checked}}checked{{/if}}>
					{{/each}}
					{{/each}}
				</span>
			</div>
			<p class="stonetop-supplies-pool-note">{{{localize "stonetop.inventory.regularUndefinedPoolNote"}}}</p>
			<div class="stonetop-inv-divider" aria-hidden="true"></div>
			{{> "stonetop.outfit-items" sections=stonetop.outfit.regularSections addColumn="regular"}}
		</div>

		{{!-- Small items (right column) --}}
		<div class="stonetop-inventory-small">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.smallItems")}}
			<p class="stonetop-inv-section-note">{{{localize "stonetop.inventory.smallItemsNote"}}}</p>
			<div class="stonetop-inv-divider" aria-hidden="true"></div>
			{{!-- Small pool --}}
			<div class="stonetop-supplies-pool">
				<span class="stonetop-supplies-pool-label"><strong>{{localize "stonetop.inventory.smallUndefinedPoolLabel"}}</strong></span>
				<span class="stonetop-supplies-pool-diamonds">
					{{#each (poolGroups stonetop.outfit.smallPool)}}
					{{#unless @first}}<span class="stonetop-supplies-pool-gap"></span>{{/unless}}
					{{#each this}}
					<input type="checkbox"
					       class="stonetop-inv-square stonetop-small-pool-btn{{#if checked}} is-checked{{/if}}"
					       aria-label="{{localize 'stonetop.a11y.smallItems' position=(inc index)}}"
					       data-change-action="smallPool"
					       data-index="{{index}}"
					       {{#if checked}}checked{{/if}}>
					{{/each}}
					{{/each}}
				</span>
			</div>
			<p class="stonetop-supplies-pool-note">{{{localize "stonetop.inventory.smallUndefinedPoolNote"}}}</p>
			<div class="stonetop-inv-divider" aria-hidden="true"></div>
			{{> "stonetop.outfit-items" sections=stonetop.outfit.smallSections addColumn="small" addLabel="stonetop.inventory.addSmallItem" square=true}}
			<div>
				{{> "stonetop.section-heading" title=(localize "stonetop.inventory.otherItems")}}
				<p class="stonetop-inv-section-note">{{{localize "stonetop.inventory.otherItemsNote"}}}</p>
				<textarea class="stonetop-notes st-notes-textarea" data-change-action="inventoryOtherItems" type="text" placeholder=""
				          aria-label="{{localize 'stonetop.a11y.otherItems'}}">{{stonetop.outfit.otherItems}}</textarea>
			</div>
		</div>

	</section>
	{{/if}}

</div>
