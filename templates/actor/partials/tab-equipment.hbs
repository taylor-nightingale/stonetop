<div class="tab equipment" data-group="primary" data-tab="inventory">

	{{#if stonetop.editMode}}
	<div class="stonetop-inventory-toolbar">
		<button type="button" class="stonetop-inventory-reset-btn" title="{{localize 'stonetop.inventory.resetTitle'}}">
			<i class="fas fa-undo"></i> {{localize "stonetop.inventory.resetLabel"}}
		</button>
	</div>
	{{/if}}

	{{#if stonetop.inventory}}

	{{!-- Outfit header: load is a derived readout — the highlighted tier reflects
	     the ◇ you've actually marked (item weights + the undefined pool). --}}
	<div class="stonetop-outfit-header">
		<p class="stonetop-outfit-heading">{{{localize "stonetop.inventory.outfit.heading"}}}</p>
		<ul class="stonetop-outfit-loads">
			<li>
				<span class="stonetop-outfit-load-label{{#if stonetop.inventory.outfit.load.loadLevelLight}} is-checked{{/if}}">
					<span class="stonetop-outfit-load-marker"></span>
					<span>{{#if stonetop.inventory.outfit.hasPackHorse}}{{{localize "stonetop.inventory.outfit.lightPackHorse"}}}{{else}}{{{localize "stonetop.inventory.outfit.light"}}}{{/if}}</span>
				</span>
			</li>
			<li>
				<span class="stonetop-outfit-load-label{{#if stonetop.inventory.outfit.load.loadLevelNormal}} is-checked{{/if}}">
					<span class="stonetop-outfit-load-marker"></span>
					<span>{{#if stonetop.inventory.outfit.hasPackHorse}}{{{localize "stonetop.inventory.outfit.normalPackHorse"}}}{{else}}{{{localize "stonetop.inventory.outfit.normal"}}}{{/if}}</span>
				</span>
			</li>
			<li>
				<span class="stonetop-outfit-load-label{{#if stonetop.inventory.outfit.load.loadLevelHeavy}} is-checked{{/if}}">
					<span class="stonetop-outfit-load-marker"></span>
					<span>{{#if stonetop.inventory.outfit.hasPackHorse}}{{{localize "stonetop.inventory.outfit.heavyPackHorse"}}}{{else}}{{{localize "stonetop.inventory.outfit.heavy"}}}{{/if}}</span>
				</span>
			</li>
		</ul>
		<p class="stonetop-outfit-load-current">
			{{{format "stonetop.inventory.outfit.currentLoad" count=stonetop.inventory.outfit.load.totalMarks}}}{{#if stonetop.inventory.outfit.load.loadLevelOverloaded}} <strong class="stonetop-outfit-overloaded">{{localize "stonetop.inventory.outfit.overloaded"}}</strong>{{/if}}
		</p>
	</div>

	<section class="stonetop-inventory">

		{{!-- Regular items (left column) --}}
		<div class="stonetop-inventory-regular">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.regularItems")}}
			<hr class="stonetop-inv-separator">
			{{!-- Regular pool --}}
			<div class="stonetop-supplies-pool">
				<span class="stonetop-supplies-pool-label"><strong>{{localize "stonetop.inventory.regularUndefinedPoolLabel"}}</strong></span>
				<span class="stonetop-supplies-pool-diamonds" data-pool-cap="{{stonetop.inventory.outfit.regularPoolCap}}">
					{{#each (poolGroups stonetop.inventory.outfit.regularPool)}}
					{{#unless @first}}<span class="stonetop-supplies-pool-gap"></span>{{/unless}}
					{{#each this}}
					<input type="checkbox"
					       class="stonetop-inv-diamond stonetop-regular-pool-btn{{#if checked}} is-checked{{/if}}"
					       data-index="{{index}}"
					       {{#if checked}}checked{{/if}}>
					{{/each}}
					{{/each}}
				</span>
			</div>
			<p class="stonetop-supplies-pool-note">{{{localize "stonetop.inventory.regularUndefinedPoolNote"}}}</p>
			<hr class="stonetop-inv-separator">
			{{#each stonetop.inventory.outfit.regularSegments}}
			{{#if isGrid}}
			{{#if segmentBreak}}<hr class="stonetop-inv-separator">{{/if}}
			<div class="stonetop-inv-twocol-grid">
				{{#each items}}
				<div class="stonetop-inv-item{{#if checked}} is-checked{{/if}}">
					<label class="stonetop-inv-item-toggle">
						<span class="stonetop-inv-diamonds">
							{{#each (times weight)}}
							<input type="checkbox" class="stonetop-inventory-item-check stonetop-inv-diamond"
							       data-slug="{{../slug}}"
							       data-weight="{{../weight}}"
							       {{#if ../checked}}checked{{/if}}
							       {{#if ../disabled}}disabled{{/if}}>
							{{/each}}
						</span>
						<span class="stonetop-inv-label">{{name}}
							{{#if note}}<span class="stonetop-inv-note">({{{note}}})</span>{{/if}}
						</span>
					</label>
					{{#if isCustom}}
					<a class="stonetop-inv-delete" data-owned-id="{{ownedId}}" title="{{localize 'stonetop.inventory.removeItem'}}"><i class="fas fa-times"></i></a>
					{{/if}}
				</div>
				{{/each}}
			</div>
			{{else}}
			{{#each items}}
			{{#if breakBefore}}<hr class="stonetop-inv-separator">{{/if}}
			<div class="stonetop-inv-item{{#if checked}} is-checked{{/if}}">
				<label class="stonetop-inv-item-toggle">
					<span class="stonetop-inv-diamonds">
						{{#each (times weight)}}
						<input type="checkbox" class="stonetop-inventory-item-check stonetop-inv-diamond"
						       data-slug="{{../slug}}"
						       data-weight="{{../weight}}"
						       {{#if ../checked}}checked{{/if}}
						       {{#if ../disabled}}disabled{{/if}}>
						{{/each}}
					</span>
					<span class="stonetop-inv-label">{{name}}
						{{#if (or note resource)}}<span class="stonetop-inv-note">({{{note}}}{{#if resource}}{{#if note}} {{/if}}<span class="stonetop-inv-resources">{{> "stonetop.resource-track" resource=resource btnClass="stonetop-inv-resource-btn stonetop-inventory-resource-btn" slug=slug}}</span>{{/if}})</span>{{/if}}
					</span>
				</label>
				{{#if isCustom}}
				<a class="stonetop-inv-delete" data-owned-id="{{ownedId}}" title="{{localize 'stonetop.inventory.removeItem'}}"><i class="fas fa-times"></i></a>
				{{/if}}
				{{#if isAddedSpecial}}
				<a class="stonetop-inv-remove-special" data-slug="{{slug}}" title="Remove special item"><i class="fas fa-times"></i></a>
				{{/if}}
			</div>
			{{#if (eq slug "even-more-supplies")}}<p class="stonetop-inv-section-note">{{{localize "stonetop.inventory.regularItemsNote"}}}</p>{{/if}}
			{{/each}}
			{{/if}}
			{{/each}}
			<button type="button" class="stonetop-inv-add-btn" data-column="regular">
				<i class="fas fa-plus"></i> {{localize "stonetop.inventory.addItem"}}
			</button>
			{{#if stonetop.inventory.outfit.arcanaItems.length}}
			<hr class="stonetop-inv-separator">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.arcanaItems")}}
			<hr class="stonetop-inv-separator">
			{{#each stonetop.inventory.outfit.arcanaItems}}
			<div class="stonetop-inv-item{{#if checked}} is-checked{{/if}}">
				<span class="stonetop-inv-diamonds">
					{{#each (times weight)}}
					<input type="checkbox" class="stonetop-inventory-item-check stonetop-inv-diamond"
					       data-slug="{{../slug}}"
					       data-weight="{{../weight}}"
					       {{#if ../checked}}checked{{/if}}
					       {{#if ../disabled}}disabled{{/if}}>
					{{/each}}
				</span>
				<span class="stonetop-inv-label">{{name}}
					{{#if note}}<span class="stonetop-inv-note">({{{note}}})</span>{{/if}}
				</span>
			</div>
			{{/each}}
			{{/if}}
		</div>

		{{!-- Small items (right column) --}}
		<div class="stonetop-inventory-small" data-small-allotment="{{stonetop.inventory.outfit.smallItemLimit}}">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.smallItems")}}
			{{#if stonetop.inventory.outfit.smallItemLimit}}
			<p class="stonetop-inv-section-note">{{{format "stonetop.inventory.smallItemsNoteWithLimit" limit=stonetop.inventory.outfit.smallItemLimit}}}</p>
			{{else}}
			<p class="stonetop-inv-section-note">{{{localize "stonetop.inventory.smallItemsNote"}}}</p>
			{{/if}}
			<hr class="stonetop-inv-separator">
			{{!-- Small pool --}}
			<div class="stonetop-supplies-pool">
				<span class="stonetop-supplies-pool-label"><strong>{{localize "stonetop.inventory.smallUndefinedPoolLabel"}}</strong></span>
				<span class="stonetop-supplies-pool-diamonds" data-pool-cap="{{stonetop.inventory.outfit.smallPoolCap}}">
					{{#each (poolItems stonetop.inventory.outfit.smallPool)}}
					<input type="checkbox"
					       class="stonetop-inventory-item-check stonetop-small-pool-display{{#if checked}} is-checked{{/if}}"
					       data-index="{{index}}"
					       {{#if checked}}checked{{/if}}>
					{{/each}}
				</span>
			</div>
			<p class="stonetop-supplies-pool-note">{{{localize "stonetop.inventory.smallUndefinedPoolNote"}}}</p>
			<hr class="stonetop-inv-separator">
			{{#each stonetop.inventory.outfit.smallItems}}
			{{#if breakBefore}}<hr class="stonetop-inv-separator">{{/if}}
			<div class="stonetop-inv-item stonetop-inv-small{{#if checked}} is-checked{{/if}}">
				<label class="stonetop-inv-item-toggle">
					<input type="checkbox" class="stonetop-inventory-item-check"
					       data-slug="{{slug}}"
					       {{#if checked}}checked{{/if}}
					       {{#if disabled}}disabled{{/if}}>
					<span class="stonetop-inv-label">{{name}}
						{{#if (or note resource)}}<span class="stonetop-inv-note">({{{note}}}{{#if resource}}{{#if note}} {{/if}}<span class="stonetop-inv-resources">{{> "stonetop.resource-track" resource=resource btnClass="stonetop-inv-resource-btn stonetop-inventory-resource-btn" slug=slug}}</span>{{/if}})</span>{{/if}}
					</span>
				</label>
				{{#if isCustom}}
				<a class="stonetop-inv-delete" data-owned-id="{{ownedId}}" title="{{localize 'stonetop.inventory.removeItem'}}"><i class="fas fa-times"></i></a>
				{{/if}}
				{{#if isAddedSpecial}}
				<a class="stonetop-inv-remove-special" data-slug="{{slug}}" title="Remove special item"><i class="fas fa-times"></i></a>
				{{/if}}
			</div>
			{{/each}}
			{{#if stonetop.inventory.outfit.smallGridItems.length}}
			<hr class="stonetop-inv-separator">
			<div class="stonetop-inv-grid">
				{{#each stonetop.inventory.outfit.smallGridItems}}
				<div class="stonetop-inv-item stonetop-inv-small{{#if checked}} is-checked{{/if}}">
					<label class="stonetop-inv-item-toggle">
						<input type="checkbox" class="stonetop-inventory-item-check"
						       data-slug="{{slug}}"
						       {{#if checked}}checked{{/if}}
						       {{#if disabled}}disabled{{/if}}>
						<span class="stonetop-inv-label">{{name}}</span>
					</label>
				</div>
				{{/each}}
			</div>
			{{/if}}
			<button type="button" class="stonetop-inv-add-btn" data-column="small">
				<i class="fas fa-plus"></i> {{localize "stonetop.inventory.addSmallItem"}}
			</button>
		</div>

	</section>


	{{/if}}

	{{#if stonetop.inventory.possessions}}
	<div class="tab-section tab-section--possessions">
		<div class="stonetop-details-heading-row">
			{{#if stonetop.possessionsEdit}}
			{{> "stonetop.section-heading" title=(localize "stonetop.character.gear.specialPossessions") note=stonetop.inventory.possessions.pickNote}}
			{{else}}
			{{> "stonetop.section-heading" title=(localize "stonetop.character.gear.specialPossessions")}}
			{{/if}}
			{{> "stonetop.details-section-edit-toggle" section="possessions" editing=stonetop.possessionsEdit}}
		</div>
		<ol class="stonetop-possession-list">
		{{#each stonetop.inventory.possessions.items}}
			<li class="stonetop-item{{#if checked}} is-checked{{/if}}">
				<div class="stonetop-item-header">
					<input type="checkbox" class="stonetop-item-check stonetop-possession-check"
					       data-slug="{{slug}}"
					       {{#if checked}}checked{{/if}}
					       {{#if (or disabled (not @root.stonetop.possessionsEdit))}}disabled{{/if}}>
					<strong class="stonetop-item-name">{{{label}}}</strong>
					{{#if preselectedSource}}<span class="stonetop-item-source">{{preselectedSource}}</span>{{/if}}
					{{#if isCustom}}<span class="stonetop-item-source">Write-in</span>{{/if}}
					{{#if (and checked resource)}}
					<span class="stonetop-item-resources">
						{{#if usesLabel}}<span class="stonetop-uses-label">{{usesLabel}}</span>{{/if}}
						{{> "stonetop.resource-track" resource=resource btnClass="stonetop-item-resource-check" possessionSlug=slug}}
					</span>
					{{/if}}
					{{#if @root.stonetop.possessionsEdit}}
					{{#if isAuthored}}
					<a class="stonetop-possession-authored-edit" data-slug="{{slug}}" title="{{localize 'stonetop.character.gear.editPossession'}}"><i class="fas fa-pen-to-square"></i></a>
					<a class="stonetop-possession-authored-remove" data-slug="{{slug}}" title="{{localize 'stonetop.character.gear.removePossession'}}"><i class="fas fa-times"></i></a>
					{{else}}{{#if isCustom}}
					<a class="stonetop-possession-custom-remove" data-slug="{{slug}}" title="{{localize 'stonetop.character.gear.removePossession'}}"><i class="fas fa-times"></i></a>
					{{/if}}{{/if}}
					{{/if}}
				</div>
				{{#if description}}
				<div class="stonetop-item-description">{{{description}}}</div>
				{{/if}}
				{{#if (and checked choices)}}
				<ol class="stonetop-sub-choice-list">
				{{#each choices.options}}
					<li class="stonetop-sub-choice{{#if checked}} is-checked{{/if}}">
						<label class="stonetop-sub-choice-label">
							<input type="checkbox" class="stonetop-item-check stonetop-possession-sub-check"
							       data-possession-slug="{{../slug}}"
							       data-choice-slug="{{slug}}"
							       {{#if checked}}checked{{/if}}
							       {{#if (or disabled (not @root.stonetop.possessionsEdit))}}disabled{{/if}}>
							{{{label}}}
						</label>
						{{#if (and checked resource)}}
						<span class="stonetop-item-resources">
							{{> "stonetop.resource-track" resource=resource btnClass="stonetop-item-resource-check" possessionSlug=../slug choiceSlug=slug}}
						</span>
						{{/if}}
					</li>
				{{/each}}
				</ol>
				{{/if}}
				{{> "stonetop.possession-choice-groups"}}
			</li>
		{{/each}}
		</ol>
		{{#if stonetop.inventory.possessions.isIncomplete}}
		<div class="stonetop-details-onboarding-actions">
			<button type="button" class="stonetop-choose-possessions-btn" data-onboarding-start="possession">
				<i class="fas fa-question-circle" aria-hidden="true"></i>
				{{localize "stonetop.inventory.choosePossessionsButton"}}
			</button>
		</div>
		{{/if}}
		{{#if stonetop.possessionsEdit}}
		<div class="stonetop-possession-add-custom-row">
			<button type="button" class="stonetop-possession-add-custom">
				<i class="fas fa-plus"></i> {{localize "stonetop.character.gear.addCustomPossession"}}
			</button>
		</div>
		{{/if}}
	</div>
	{{/if}}


</div>
