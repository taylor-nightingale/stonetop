{{!-- The Playbook tab (D11). Every choice rests on what was chosen and has one door, on its bar, to the
      rest; opening everything is an event (choosing a playbook), not a standing state, and while a
      section is open nothing on offer is hidden. No lock: each section is its own door.

      Two FIXED columns — the background in one, the instinct, appearance and origin in the other —
      so a section opening never moves another across under the pointer. The playbook's own story
      and the introductions run across both beneath. Each bar's place on this tab picks its texture. --}}
<div class="tab playbook {{tabs.playbook.cssClass}}" data-group="primary" data-tab="playbook">
	<section class="sheet-tab">
	{{#unless stonetop.playbook}}
	<div class="stonetop-playbook-empty">
		<p class="stonetop-playbook-empty-hint">{{localize "stonetop.sheet.playbook.emptyHint"}}</p>
		<select class="stonetop-playbook-select" name="stonetop-playbook-select" data-change-action="selectPlaybook"
		        aria-label="{{localize 'stonetop.a11y.playbookSelect'}}">
			<option value="">— {{localize "stonetop.sheet.playbook.selectPlaceholder"}} —</option>
			{{#each availablePlaybooks}}
			<option value="{{slug}}">{{name}}</option>
			{{/each}}
		</select>
	</div>
	{{else}}
	{{!-- The playbook's title is the masthead's, beside the character's own name. --}}
	{{#if stonetop.playbook.description.raw}}
	<div class="stonetop-playbook-intro">
		<p class="stonetop-playbook-description">{{rich stonetop.playbook.description}}</p>
	</div>
	{{/if}}
	<div class="stonetop-section-columns">
		<div class="stonetop-section-column">
			{{#if stonetop.playbook.background.options.length}}
			{{> "stonetop.playbook-section" section=stonetop.playbookSections.background index=0
			    title=(localize "stonetop.character.selection.background.label")
			    note=(localize "stonetop.character.selection.chooseOne")
			    rest="stonetop.background-rest" choose="stonetop.background-choose" data=stonetop.playbook.background}}
			{{/if}}
		</div>
		<div class="stonetop-section-column">
			{{> "stonetop.playbook-section" section=stonetop.playbookSections.instinct index=1
			    title=(localize "stonetop.character.selection.instinct.label")
			    note=(localize "stonetop.character.selection.chooseOne")
			    rest="stonetop.instinct-rest" choose="stonetop.instinct-choose"
			    instinctSelected=stonetop.playbook.instinctSelected instinctGroup=stonetop.playbook.instinctGroup
			    namePrefix="stonetop-instinct" cgContext="instinct"
			    setAsideBy=(ifThen stonetop.instinct.isFromInsert stonetop.instinct null)}}
			{{#if stonetop.playbook.appearanceGroup}}
			{{> "stonetop.playbook-section" section=stonetop.playbookSections.appearance index=2
			    title=(localize "stonetop.character.selection.appearance.label")
			    note=(localize "stonetop.character.selection.appearance.instruction")
			    rest="stonetop.group-rest" choose="stonetop.group-choose"
			    group=stonetop.playbook.appearanceGroup cgContext="appearance"}}
			{{/if}}
			{{#if stonetop.playbook.origin.options.length}}
			{{> "stonetop.playbook-section" section=stonetop.playbookSections.origin index=3
			    title=(localize "stonetop.character.selection.origin.label")
			    note=(localize "stonetop.character.selection.origin.instruction")
			    rest="stonetop.origin-rest" choose="stonetop.origin-choose" data=stonetop.playbook.origin}}
			{{/if}}
		</div>
	</div>
	{{#each stonetop.playbookSections.lore}}
	{{> "stonetop.playbook-section" section=section index=(add 4 @index) title=title note=note
	    rest="stonetop.lore-rest" choose="stonetop.lore-choose" lore=this}}
	{{/each}}
	{{#if stonetop.playbookSections.introductions}}
	{{> "stonetop.playbook-section" section=stonetop.playbookSections.introductions index=(add 4 stonetop.playbookSections.lore.length)
	    title=(localize "stonetop.sheet.playbook.introductions.title")
	    rest="stonetop.introductions-rest" choose="stonetop.introductions-steps" intro=stonetop.playbook.introductions}}
	{{/if}}
	{{/unless}}
	</section>
</div>
