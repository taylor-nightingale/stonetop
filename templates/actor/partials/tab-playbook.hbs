<div class="tab playbook {{tabs.playbook.cssClass}}{{#if viewFlags.playbookLocked}} is-locked{{/if}}" data-group="primary" data-tab="playbook">
	<section class="sheet-tab">

	{{#unless stonetop.playbook}}
	<div class="stonetop-playbook-empty">
		<p class="stonetop-playbook-empty-hint">{{localize "stonetop.sheet.playbook.emptyHint"}}</p>
		<select class="stonetop-playbook-select" name="stonetop-playbook-select" data-change-action="selectPlaybook"
		        aria-label="{{localize 'stonetop.a11y.playbookSelect'}}">
			<option value="">— {{localize "stonetop.sheet.playbook.selectPlaceholder"}} —</option>
			{{#each availablePlaybooks}}
			<option value="{{slug}}">{{name}}</option>
			{{/each}}
		</select>
	</div>
	{{else}}
	{{!-- The lock is the tab's own view state, so it rides the shared toolbar toggle. --}}
	<div class="stonetop-playbook-toolbar">
		{{#if viewFlags.playbookLocked}}
		{{> "stonetop.tab-toolbar-toggle" flag="playbookLocked" icon="fa-lock" active=true
		    label=(localize "stonetop.sheet.lock.unlock")
		    title=(localize "stonetop.sheet.lock.unlockHint")}}
		{{else}}
		{{> "stonetop.tab-toolbar-toggle" flag="playbookLocked" icon="fa-lock-open"
		    label=(localize "stonetop.sheet.lock.lock")
		    title=(localize "stonetop.sheet.lock.lockHint")}}
		{{/if}}
	</div>
	{{#if (or stonetop.playbook.titleImg stonetop.playbook.description.raw)}}
	<div class="stonetop-playbook-intro">
		{{#if stonetop.playbook.titleImg}}<img class="stonetop-playbook-title-img" src="{{stonetop.playbook.titleImg}}" alt="{{stonetop.playbook.name}}">{{/if}}
		{{#if stonetop.playbook.description.raw}}<p class="stonetop-playbook-description">{{rich stonetop.playbook.description}}</p>{{/if}}
	</div>
	{{/if}}
	<div class="stonetop-playbook-columns">

		{{> "stonetop.choice-section" groups=stonetop.playbook.loreGroups cgContext="lore" locked=viewFlags.playbookLocked}}

		{{#if stonetop.playbook.background.options.length}}
		<div class="details-section">
			{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.background.label") note=(localize "stonetop.character.selection.chooseOne")}}
			{{#each stonetop.playbook.background.options}}
			{{#unless (and @root.viewFlags.playbookLocked (not selected))}}
			<label class="stonetop-item{{#if selected}} is-checked{{/if}}">
				<div class="stonetop-item-header">
					{{#unless @root.viewFlags.playbookLocked}}
					<input type="radio" class="stonetop-item-check" data-change-action="selectBackground" name="stonetop-background" value="{{slug}}"{{#if selected}} checked{{/if}}>
					{{/unless}}
					<strong class="stonetop-item-name">{{rich label}}</strong>
					{{#if resource}}
					<span class="stonetop-item-resources">
						{{> "stonetop.resource-track" resource=resource btnClass="stonetop-background-resource-btn" action="backgroundResourcePip" slug=slug}}
					</span>
					{{/if}}
				</div>
				{{#if description.raw}}
				<div class="stonetop-item-description">{{rich description}}</div>
				{{/if}}
				{{#if choices}}
				<div class="stonetop-bg-choices">
					{{#if @root.viewFlags.playbookLocked}}
					{{> "stonetop.choice-group-condensed" blocks=choices.condensed}}
					{{else}}
					{{#each choices.list}}
					{{> "stonetop.choice-row" cgContext="background" cgGroup=../choices.slug namePrefix=../slug}}
					{{/each}}
					{{/if}}
				</div>
				{{/if}}
			</label>
			{{/unless}}
			{{/each}}
		</div>
		{{/if}}

		{{#if stonetop.playbook}}
		{{> "stonetop.instinct-section"
		    instinctSelected=stonetop.playbook.instinctSelected
		    instinctGroup=stonetop.playbook.instinctGroup
		    namePrefix="stonetop-instinct"
		    cgContext="instinct"
		    locked=viewFlags.playbookLocked}}
		{{/if}}

		{{#if stonetop.playbook.appearanceGroup}}
		<div class="details-section">
			{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.appearance.label") note=(localize "stonetop.character.selection.appearance.instruction")}}
			{{#with stonetop.playbook.appearanceGroup}}
			{{> "stonetop.choice-group" cgContext="appearance" locked=@root.viewFlags.playbookLocked}}
			{{/with}}
		</div>
		{{/if}}

		{{#if stonetop.playbook.origin.options.length}}
		<div class="details-section">
			{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.origin.label") note=(localize "stonetop.character.selection.origin.instruction")}}
			{{#each stonetop.playbook.origin.options}}
			{{#unless (and @root.viewFlags.playbookLocked (not selected))}}
			<div class="stonetop-origin-option{{#if selected}} selected{{/if}}">
				<label class="stonetop-origin-region">
					{{#unless @root.viewFlags.playbookLocked}}
					<input type="radio" class="stonetop-item-check" data-change-action="selectOrigin" name="stonetop-origin"
					       value="{{region}}"{{#if selected}} checked{{/if}}>
					{{/unless}}
					<strong>{{region}}</strong>
				</label>
				{{#unless @root.viewFlags.playbookLocked}}
				<div class="stonetop-origin-names">
					{{#each names}}<button type="button" class="stonetop-origin-name" data-action="selectOriginName">{{this}}</button>{{#unless @last}}, {{/unless}}{{/each}}
				</div>
				{{/unless}}
			</div>
			{{/unless}}
			{{/each}}
		</div>
		{{/if}}

	</div>

	{{!-- Locked, the introductions are worth the room only if something was answered — otherwise the
	      divider and heading stand over nothing. --}}
	{{#if (or (not viewFlags.playbookLocked) stonetop.playbook.introductions.hasAnswers)}}
	{{#if stonetop.playbook.introductions}}
	<div class="stonetop-panel-divider" aria-hidden="true"></div>
	{{> "stonetop.introductions-section" intro=stonetop.playbook.introductions}}
	{{/if}}
	{{/if}}
	{{/unless}}

	</section>
</div>
