{{!-- A multi-select Selection as removable pills + an input to add one. Click a pill to remove
      it; type a custom tag and commit (blur/Enter) to add. The ▾ dropdown only appears when the
      field has preset options.
      Params: sel (Selection snapshot), slug, field, placeholder. --}}
<div class="stonetop-tags" data-slug="{{slug}}" data-field="{{field}}">
	{{#each sel.values}}
	<button type="button" class="stonetop-tag-chip is-selected" data-slug="{{../slug}}" data-tag="{{this}}"
	        title="{{localize 'stonetop.npc.removeTag'}}">{{this}}</button>
	{{/each}}
	<span class="stonetop-combo stonetop-combo--add">
		<input type="text" class="stonetop-tag-add stonetop-combo-input"
		       data-slug="{{slug}}" data-field="{{field}}" placeholder="{{placeholder}}">
		{{#if sel.unselectedOptions.length}}
		<button type="button" class="stonetop-combo-toggle" tabindex="-1" aria-label="{{placeholder}}">▾</button>
		<ul class="stonetop-combo-list" hidden>
			{{#each sel.unselectedOptions}}<li class="stonetop-combo-option" data-value="{{this}}">{{this}}</li>{{/each}}
		</ul>
		{{/if}}
	</span>
</div>
