{{!-- The top band (D7): who this is, the six stats and their conditions, what ails you, and the
      line it folds to. The portrait and HP/Armor/Damage are the rail's, so there is no picture
      column: masthead across the top, the numbers beside the ailments, the foot under them.

      The masthead is the part the fold never takes. The numbers and the ailments fold together;
      the ledger in the foot is the same stats at line height, and folding reveals it. Context: the
      root. --}}
<div class="stonetop-band stonetop-head">
	{{> "stonetop.character-masthead"}}

	<section class="sheet-top" id="{{sheetIdPrefix}}-band">
		<div class="stonetop-stats-column">
			{{> "stonetop.section-heading" title=(localize "stonetop.character.stats.sectionTitle") note=stonetop.playbook.statsNote}}

			{{> "stonetop.actor-stats" pairs=stonetop.statPairs}}
			{{> "stonetop.debility-bands" debilities=stonetop.debilities}}
		</div>
	</section>

	{{> "stonetop.ailments"}}

	{{!-- The band's foot: the line it folds TO. The roll mode is not here: every roll asks for it
	      (RollModeDialog). --}}
	<div class="stonetop-band-foot">
		{{> "stonetop.folded-ledger"}}
	</div>

	{{!-- The fold control: a tab on the band's bottom edge, the rail's tab turned on its side, in the
	      same place open and folded. --}}
	<button type="button" class="stonetop-top-toggle" data-action="toggleTop" data-view-state
	        aria-expanded="true" aria-controls="{{sheetIdPrefix}}-band"
	        data-label-show="{{localize 'stonetop.sheet.bandShow'}}"
	        data-label-hide="{{localize 'stonetop.sheet.bandHide'}}"
	        title="{{localize 'stonetop.sheet.bandHide'}}"
	        aria-label="{{localize 'stonetop.sheet.bandHide'}}">
		<i class="fas fa-chevron-up stonetop-top-caret" aria-hidden="true"></i>
	</button>
</div>
