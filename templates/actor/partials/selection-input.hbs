{{!-- Single-select Selection (instinct): an input + an optional ▾ dropdown of preset options.
      Type a custom value in the input; pick from the list only when options exist. The input
      carries inputClass so the sheet's change handler saves it.
      Params: sel, slug, field, inputClass, placeholder. --}}
<span class="stonetop-combo">
	<input type="text" class="{{inputClass}} stonetop-combo-input" value="{{sel.text}}"
	       data-slug="{{slug}}" placeholder="{{placeholder}}">
	{{#if sel.options.length}}
	<button type="button" class="stonetop-combo-toggle" tabindex="-1" aria-label="{{placeholder}}">▾</button>
	<ul class="stonetop-combo-list" hidden>
		{{#each sel.options}}<li class="stonetop-combo-option" data-value="{{this}}">{{this}}</li>{{/each}}
	</ul>
	{{/if}}
</span>
