{{!-- V2 part: single root element; the sheet root form + classes come from DEFAULT_OPTIONS. --}}
<div>

	<header class="sheet-header steading-top">
		<div class="steading-steadfast-row">
			{{!-- Name combobox: type the steading's own name, or pick a steadfast from the list (which
			      seeds its profile and adopts its name). Dropping a steadfast onto the sheet does the same. --}}
			<span class="stonetop-combo steading-steadfast-combo">
				<input type="text" class="steading-steadfast-input stonetop-combo-input" data-change-action="steadfastName" value="{{actor.name}}"
				       aria-label="{{localize 'stonetop.a11y.steadingName'}}"
				       placeholder="{{localize 'stonetop.steadfast.namePlaceholder'}}" {{#unless editable}}disabled{{/unless}}>
				{{#if availableSteadfasts.length}}
				<button type="button" class="stonetop-combo-toggle" tabindex="-1" aria-label="Steadfasts">▾</button>
				<ul class="stonetop-combo-list" hidden>
					{{#each availableSteadfasts}}<li class="stonetop-combo-option" data-value="{{name}}">{{name}}</li>{{/each}}
				</ul>
				{{/if}}
			</span>
			<span class="steading-steadfast-hint">Type a name, or pick / drag a steadfast.</span>
		</div>
		<section class="steading-header-grid">

			{{!-- Fortunes --}}
			<div class="steading-stat-panel steading-panel-frame steading-fortunes">
				<span class="panel-corner panel-corner-tl"></span>
				<span class="panel-corner panel-corner-tr"></span>
				<span class="panel-corner panel-corner-bl"></span>
				<span class="panel-corner panel-corner-br"></span>
				<span class="panel-edge panel-edge-top"></span>
				<span class="panel-edge panel-edge-right"></span>
				<span class="panel-edge panel-edge-bottom"></span>
				<span class="panel-edge panel-edge-left"></span>
				<h2>
					<button class="steading-stat-roll rollable" type="button" data-roll="fortunes">Fortunes</button>
				</h2>
				{{#if (hasText stonetop.fortunes.note)}}<div class="steading-start-line">{{rich stonetop.fortunes.note}}</div>{{/if}}
				<div class="steading-rating-options">
					{{#each stonetop.fortunes.options}}
						<label class="steading-rating-option">
							<input class="steading-box-input" type="radio" name="stonetop-fortunes" data-change-action="fortunes" value="{{value}}" {{#if selected}}checked{{/if}}>
							<span class="steading-box" aria-hidden="true"></span>
							<span class="steading-option-text"><span>{{rich label}}</span></span>
						</label>
					{{/each}}
				</div>
			</div>

			{{!-- Surplus --}}
			<div class="steading-stat-panel steading-panel-frame steading-surplus">
				<span class="panel-corner panel-corner-tl"></span>
				<span class="panel-corner panel-corner-tr"></span>
				<span class="panel-corner panel-corner-bl"></span>
				<span class="panel-corner panel-corner-br"></span>
				<span class="panel-edge panel-edge-top"></span>
				<span class="panel-edge panel-edge-right"></span>
				<span class="panel-edge panel-edge-bottom"></span>
				<span class="panel-edge panel-edge-left"></span>
				<h2>
					<button class="steading-stat-roll rollable" type="button" data-roll="surplus">Surplus</button>
				</h2>
				{{#if (hasText stonetop.surplus.note)}}<div class="steading-start-line">{{rich stonetop.surplus.note}}</div>{{/if}}
				<span class="stonetop-stepper">
					<input class="steading-surplus-input stonetop-step" data-change-action="surplus" aria-label="{{localize 'stonetop.a11y.surplus'}}" type="number" value="{{stonetop.surplus.current}}" min="0" step="1">
					{{> "stonetop.stepper-buttons"}}
				</span>
			</div>

			{{!-- Size --}}
			{{> "stonetop.steading-stat-panel" attr="size" title="Size" attrData=stonetop.attributes.size panelClass="steading-size"}}

			{{!-- Population --}}
			{{> "stonetop.steading-stat-panel" attr="population" title="Population" attrData=stonetop.attributes.population rollable=true panelClass="steading-population"}}

			{{!-- Prosperity --}}
			{{> "stonetop.steading-stat-panel" attr="prosperity" title="Prosperity" attrData=stonetop.attributes.prosperity rollable=true panelClass="steading-prosperity"}}

			{{!-- Defenses --}}
			{{> "stonetop.steading-stat-panel" attr="defenses" title="Defenses" attrData=stonetop.attributes.defenses rollable=true wide=true panelClass="steading-defenses"}}

			{{!-- Debilities --}}
			<div class="steading-debilities-panel steading-panel-frame">
				<span class="panel-corner panel-corner-tl"></span>
				<span class="panel-corner panel-corner-tr"></span>
				<span class="panel-corner panel-corner-bl"></span>
				<span class="panel-corner panel-corner-br"></span>
				<span class="panel-edge panel-edge-top"></span>
				<span class="panel-edge panel-edge-right"></span>
				<span class="panel-edge panel-edge-bottom"></span>
				<span class="panel-edge panel-edge-left"></span>
				<h2>Debilities</h2>
				<div class="steading-debility-list">
					{{#each stonetop.debilities}}
						<label class="steading-debility-option">
							<input class="steading-circle-input" data-change-action="debility" type="checkbox" data-slug="{{slug}}" {{#if active}}checked{{/if}}>
							<span class="steading-circle" aria-hidden="true"></span>
							<span>{{rich description}} <small>{{rich note}}</small></span>
						</label>
					{{/each}}
				</div>
			</div>

			{{!-- Roll Mode --}}
			<div class="steading-stat-panel steading-panel-frame steading-roll-mode">
				<span class="panel-corner panel-corner-tl"></span>
				<span class="panel-corner panel-corner-tr"></span>
				<span class="panel-corner panel-corner-bl"></span>
				<span class="panel-corner panel-corner-br"></span>
				<span class="panel-edge panel-edge-top"></span>
				<span class="panel-edge panel-edge-right"></span>
				<span class="panel-edge panel-edge-bottom"></span>
				<span class="panel-edge panel-edge-left"></span>
				<h2>{{localize "stonetop.rollMode.label"}}</h2>
				<div class="steading-rating-options">
					<label class="steading-rating-option">
						<input class="steading-box-input steading-roll-mode-radio" type="radio" name="stonetop-roll-mode" data-change-action="rollMode" value="normal" {{#if (eq stonetop.rollMode "normal")}}checked{{/if}}>
						<span class="steading-box" aria-hidden="true"></span>
						<span class="steading-option-text"><span>{{localize "stonetop.rollMode.normal"}}</span></span>
					</label>
					<label class="steading-rating-option">
						<input class="steading-box-input steading-roll-mode-radio" type="radio" name="stonetop-roll-mode" data-change-action="rollMode" value="adv" {{#if (eq stonetop.rollMode "adv")}}checked{{/if}}>
						<span class="steading-box" aria-hidden="true"></span>
						<span class="steading-option-text"><span>{{localize "stonetop.rollMode.adv"}}</span></span>
					</label>
					<label class="steading-rating-option">
						<input class="steading-box-input steading-roll-mode-radio" type="radio" name="stonetop-roll-mode" data-change-action="rollMode" value="dis" {{#if (eq stonetop.rollMode "dis")}}checked{{/if}}>
						<span class="steading-box" aria-hidden="true"></span>
						<span class="steading-option-text"><span>{{localize "stonetop.rollMode.dis"}}</span></span>
					</label>
				</div>
			</div>

		</section>
	</header>

	{{!-- Tab navigation --}}
	{{!-- data-action="tab" is core ApplicationV2's built-in action (→ changeTab); each anchor
	      carries data-group because changeTab addresses `.tabs [data-group][data-tab]` directly. --}}
	<nav class="sheet-tabs tabs" data-group="primary">
		<button type="button" class="item {{tabs.overview.cssClass}}" data-action="tab" data-group="primary" data-tab="overview">Overview</button>
		<button type="button" class="item {{tabs.residents.cssClass}}" data-action="tab" data-group="primary" data-tab="residents">Residents</button>
		<button type="button" class="item {{tabs.neighbors.cssClass}}" data-action="tab" data-group="primary" data-tab="neighbors">Neighbors</button>
		<button type="button" class="item {{tabs.improvements.cssClass}}" data-action="tab" data-group="primary" data-tab="improvements">Improvements</button>
		<button type="button" class="item {{tabs.moves.cssClass}}" data-action="tab" data-group="primary" data-tab="moves">Moves</button>
		<button type="button" class="item {{tabs.seasons.cssClass}}" data-action="tab" data-group="primary" data-tab="seasons">Seasons</button>
		<button type="button" class="item {{tabs.notes.cssClass}}" data-action="tab" data-group="primary" data-tab="notes">Notes</button>
	</nav>

	<section class="sheet-body">

		{{!-- Overview tab --}}
		<div class="tab {{tabs.overview.cssClass}}" data-group="primary" data-tab="overview">

			<div class="steading-overview-grid">

				<section class="steading-overview-column">
					{{> "stonetop.steading-ratings-list" title="Resources" attr="prosperity" items=stonetop.attributes.prosperity.items}}
				</section>

				<div class="steading-overview-divider" aria-hidden="true"></div>

				<section class="steading-overview-column">
					{{> "stonetop.steading-ratings-list" title="Defenses" attr="defenses" items=stonetop.attributes.defenses.items}}
				</section>

				<div class="steading-overview-divider" aria-hidden="true"></div>

				<section class="steading-overview-column steading-assets-column">
					{{> "stonetop.steading-assets" items=stonetop.assets.items coinage=stonetop.assets.coinage}}
				</section>

			</div>


		</div>{{!-- /tab overview --}}

		{{!-- Residents tab --}}
		<div class="tab {{tabs.residents.cssClass}}" data-group="primary" data-tab="residents">

			<div class="steading-residents-grid">

				<section class="steading-residents-roster steading-panel-frame">
					<span class="panel-corner panel-corner-tl"></span>
					<span class="panel-corner panel-corner-tr"></span>
					<span class="panel-corner panel-corner-bl"></span>
					<span class="panel-corner panel-corner-br"></span>
					<span class="panel-edge panel-edge-top"></span>
					<span class="panel-edge panel-edge-right"></span>
					<span class="panel-edge panel-edge-bottom"></span>
					<span class="panel-edge panel-edge-left"></span>

					<div class="steading-residents-table">
						<div class="steading-residents-header">
							<span>{{localize "stonetop.steading.colName"}}</span>
							<span>{{localize "stonetop.steading.colOccupation"}}</span>
							<span>{{localize "stonetop.steading.colTraits"}}</span>
							<span>{{localize "stonetop.steading.linkColumn"}}</span>
						</div>
						<div class="steading-residents-rows">
							{{#each stonetop.residents}}
								<div class="steading-resident-row" data-id="{{id}}" title="{{localize 'stonetop.steading.linkDropTitle'}}">
									<input type="text" class="stonetop-resident-name" data-change-action="residentName" aria-label="{{localize 'stonetop.a11y.residentName'}}" data-id="{{id}}" value="{{name}}" placeholder="Name (Pronouns)">
									<input type="text" class="stonetop-resident-occupation" data-change-action="residentOccupation" aria-label="{{localize 'stonetop.a11y.residentOccupation'}}" data-id="{{id}}" value="{{occupation}}" placeholder="Occupation">
									<input type="text" class="stonetop-resident-traits" data-change-action="residentTraits" aria-label="{{localize 'stonetop.a11y.residentTraits'}}" data-id="{{id}}" value="{{traits}}" placeholder="Traits, Relations, Etc">
									<span class="steading-doc-link">
										{{#if docLink}}
											{{rich docLink}}
											<button class="stonetop-resident-unlink" data-action="unlinkResident" type="button" data-id="{{id}}" title="{{localize 'stonetop.steading.unlink'}}" aria-label="{{localize 'stonetop.steading.unlink'}}">✕</button>
										{{/if}}
									</span>
									<button class="stonetop-resident-remove stonetop-icon-btn" data-action="removeResident" type="button" data-id="{{id}}" data-name="{{name}}" title="Delete resident" aria-label="Delete resident">
										<img src="systems/stonetop/assets/ui/controls/delete-icon.png" alt="">
									</button>
								</div>
							{{/each}}
						</div>
						<button class="stonetop-resident-add stonetop-icon-btn" data-action="addResident" type="button" title="Add resident" aria-label="Add resident">
							<img src="systems/stonetop/assets/ui/controls/plus-icon.png" alt="">
						</button>
						{{#if isGM}}
							<button class="stonetop-create-actors" data-action="createResidentActors" type="button">{{localize "stonetop.steading.createActors.residents"}}</button>
						{{/if}}
						<p class="steading-link-hint">{{localize "stonetop.steading.linkHint"}}</p>
					</div>
				</section>

				<div class="steading-residents-divider" aria-hidden="true"></div>

				<section class="steading-resident-names steading-panel-frame">
					<span class="panel-corner panel-corner-tl"></span>
					<span class="panel-corner panel-corner-tr"></span>
					<span class="panel-corner panel-corner-bl"></span>
					<span class="panel-corner panel-corner-br"></span>
					<span class="panel-edge panel-edge-top"></span>
					<span class="panel-edge panel-edge-right"></span>
					<span class="panel-edge panel-edge-bottom"></span>
					<span class="panel-edge panel-edge-left"></span>
					<h2>Names</h2>
					<p class="steading-names-text">{{stonetop.residentNames}}</p>
					<img class="steading-residents-img" src="stonetop-art/steading/residents.png" alt="">
				</section>

			</div>

			<section class="steading-npc-traits steading-panel-frame">
				<span class="panel-corner panel-corner-tl"></span>
				<span class="panel-corner panel-corner-tr"></span>
				<span class="panel-corner panel-corner-bl"></span>
				<span class="panel-corner panel-corner-br"></span>
				<span class="panel-edge panel-edge-top"></span>
				<span class="panel-edge panel-edge-right"></span>
				<span class="panel-edge panel-edge-bottom"></span>
				<span class="panel-edge panel-edge-left"></span>

				<div class="steading-npc-traits-heading">
					<h2>NPC Traits</h2>
					<span>Assign as needed; choose from this list or make up your own.</span>
				</div>
				<textarea class="steading-npc-traits-source" data-change-action="residentTraitsSource"
				          aria-label="{{localize 'stonetop.a11y.npcTraits'}}">{{stonetop.residentTraitsText}}</textarea>
				<div class="steading-npc-traits-columns">
					{{#each stonetop.npcTraitColumns}}
						<div class="steading-npc-traits-column">
							{{#each this}}
								<div class="steading-npc-trait">{{this}}</div>
							{{/each}}
						</div>
					{{/each}}
				</div>
			</section>

		</div>{{!-- /tab residents --}}

		{{!-- Neighbors tab --}}
		<div class="tab {{tabs.neighbors.cssClass}}" data-group="primary" data-tab="neighbors">

			<div class="steading-neighbors-grid">

				<section class="steading-neighbors-roster steading-panel-frame">
					<span class="panel-corner panel-corner-tl"></span>
					<span class="panel-corner panel-corner-tr"></span>
					<span class="panel-corner panel-corner-bl"></span>
					<span class="panel-corner panel-corner-br"></span>
					<span class="panel-edge panel-edge-top"></span>
					<span class="panel-edge panel-edge-right"></span>
					<span class="panel-edge panel-edge-bottom"></span>
					<span class="panel-edge panel-edge-left"></span>

					<div class="steading-residents-table steading-neighbors-table">
						<div class="steading-residents-header steading-neighbors-header">
							<span>{{localize "stonetop.steading.colName"}}</span>
							<span>{{localize "stonetop.steading.colOccupation"}}</span>
							<span>{{localize "stonetop.steading.colTraits"}}</span>
							<span>{{localize "stonetop.steading.colHome"}}</span>
							<span>{{localize "stonetop.steading.linkColumn"}}</span>
						</div>
						<div class="steading-residents-rows">
							{{#each stonetop.neighbors.people}}
								<div class="steading-resident-row steading-neighbor-row" data-id="{{id}}" title="{{localize 'stonetop.steading.linkDropTitle'}}">
									<input type="text" class="stonetop-neighbor-person-name" data-change-action="neighborName" aria-label="{{localize 'stonetop.a11y.residentName'}}" data-id="{{id}}" value="{{name}}" placeholder="Name (Pronouns)">
									<input type="text" class="stonetop-neighbor-person-occupation" data-change-action="neighborOccupation" aria-label="{{localize 'stonetop.a11y.residentOccupation'}}" data-id="{{id}}" value="{{occupation}}" placeholder="Occupation">
									<input type="text" class="stonetop-neighbor-person-traits" data-change-action="neighborTraits" aria-label="{{localize 'stonetop.a11y.residentTraits'}}" data-id="{{id}}" value="{{traits}}" placeholder="Traits, Relations, Etc">
									<input type="text" class="stonetop-neighbor-person-home" data-change-action="neighborHome" aria-label="{{localize 'stonetop.a11y.neighborHome'}}" data-id="{{id}}" value="{{home}}" placeholder="Home">
									<span class="steading-doc-link">
										{{#if docLink}}
											{{rich docLink}}
											<button class="stonetop-neighbor-person-unlink" data-action="unlinkNeighbor" type="button" data-id="{{id}}" title="{{localize 'stonetop.steading.unlink'}}" aria-label="{{localize 'stonetop.steading.unlink'}}">✕</button>
										{{/if}}
									</span>
									<button class="stonetop-neighbor-person-remove stonetop-icon-btn" data-action="removeNeighbor" type="button" data-id="{{id}}" data-name="{{name}}" title="Delete neighbor" aria-label="Delete neighbor">
										<img src="systems/stonetop/assets/ui/controls/delete-icon.png" alt="">
									</button>
								</div>
							{{/each}}
						</div>
						<button class="stonetop-neighbor-person-add stonetop-icon-btn" data-action="addNeighbor" type="button" title="Add neighbor" aria-label="Add neighbor">
							<img src="systems/stonetop/assets/ui/controls/plus-icon.png" alt="">
						</button>
						{{#if isGM}}
							<button class="stonetop-create-actors" data-action="createNeighborActors" type="button">{{localize "stonetop.steading.createActors.neighbors"}}</button>
						{{/if}}
						<p class="steading-link-hint">{{localize "stonetop.steading.linkHint"}}</p>
					</div>
				</section>

				<div class="steading-neighbors-divider" aria-hidden="true"></div>

				{{> "stonetop.steading-neighbor-places" places=stonetop.neighbors.places}}

			</div>

		</div>{{!-- /tab neighbors --}}

		{{!-- Improvements tab --}}
		<div class="tab {{tabs.improvements.cssClass}}" data-group="primary" data-tab="improvements">

			<div class="steading-improvements-grid">

				<section class="steading-improvement-column" data-column="left">
					{{#each stonetop.improvementColumns.left}}
						{{> "stonetop.steading-improvement-panel"}}
					{{/each}}
				</section>

				<div class="steading-improvements-divider" aria-hidden="true"></div>

				<section class="steading-improvement-column" data-column="middle">
					{{#each stonetop.improvementColumns.middle}}
						{{> "stonetop.steading-improvement-panel"}}
					{{/each}}
				</section>

				<div class="steading-improvements-divider" aria-hidden="true"></div>

				<section class="steading-improvement-column" data-column="right">
					{{#each stonetop.improvementColumns.right}}
						{{> "stonetop.steading-improvement-panel"}}
					{{/each}}
				</section>

			</div>

		</div>{{!-- /tab improvements --}}

		{{!-- Moves tab --}}
		<div class="tab {{tabs.moves.cssClass}}" data-group="primary" data-tab="moves">
			<section class="sheet-tab">
				{{#each stonetop.moves}}
					{{!-- alwaysShowResource: a steading's moves are its fixed set, so their resource
					      pips show whether or not the move reads as "acquired". --}}
					{{> "stonetop.move-group"
					    title=label
					    note=note
					    moves=moves
					    categoryKey=key
					    allowAdditional=false
					    alwaysShowResource=true}}
				{{else}}
					<p class="stonetop-moves-empty">No moves assigned to this steading.</p>
				{{/each}}
			</section>
		</div>{{!-- /tab moves --}}

		{{!-- Seasons Change tab --}}
		<div class="tab {{tabs.seasons.cssClass}}" data-group="primary" data-tab="seasons">
			<section class="sheet-tab">
				{{> "stonetop.steading-seasons" seasons=stonetop.seasons}}
			</section>
		</div>{{!-- /tab seasons --}}

		{{!-- Notes tab --}}
		<div class="tab {{tabs.notes.cssClass}}" data-group="primary" data-tab="notes">

			<div class="steading-notes-grid">

				<section class="steading-notes-column">
					{{> "stonetop.steading-places-of-interest" places=stonetop.placesOfInterest linkHint=true}}
				</section>

				<div class="steading-notes-divider" aria-hidden="true"></div>

				<section class="steading-notes-column steading-notes-content-column">
					{{#each stonetop.content}}
						<div class="steading-notes-field steading-notes-content-field steading-panel-frame">
							<span class="panel-corner panel-corner-tl"></span>
							<span class="panel-corner panel-corner-tr"></span>
							<span class="panel-corner panel-corner-bl"></span>
							<span class="panel-corner panel-corner-br"></span>
							<span class="panel-edge panel-edge-top"></span>
							<span class="panel-edge panel-edge-right"></span>
							<span class="panel-edge panel-edge-bottom"></span>
							<span class="panel-edge panel-edge-left"></span>
							<h2>{{rich label}}{{#if note.raw}} <small>{{rich note}}</small>{{/if}}</h2>
							<textarea class="stonetop-content-textarea" data-change-action="contentText" data-type="{{slug}}"
						          aria-label="{{localize 'stonetop.a11y.contentText' section=label.raw}}">{{text}}</textarea>
						</div>
					{{/each}}
				</section>

				<div class="steading-notes-divider" aria-hidden="true"></div>

				<section class="steading-notes-column">
					<div class="steading-notes-field steading-panel-frame">
						<span class="panel-corner panel-corner-tl"></span>
						<span class="panel-corner panel-corner-tr"></span>
						<span class="panel-corner panel-corner-bl"></span>
						<span class="panel-corner panel-corner-br"></span>
						<span class="panel-edge panel-edge-top"></span>
						<span class="panel-edge panel-edge-right"></span>
						<span class="panel-edge panel-edge-bottom"></span>
						<span class="panel-edge panel-edge-left"></span>
						<h2>Notes</h2>
						<textarea aria-label="{{localize 'stonetop.a11y.notes'}}" class="stonetop-notes" data-change-action="notes">{{stonetop.notes}}</textarea>
					</div>
				</section>

			</div>

		</div>{{!-- /tab notes --}}

	</section>{{!-- /sheet-body --}}

</div>
