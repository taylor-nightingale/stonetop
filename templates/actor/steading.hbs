<form class="{{cssClass}} steading-sheet" autocomplete="off">
	<div class="sheet-wrapper steading-sheet-wrapper">

		<div class="steading-header">
			<div class="steading-header-name">
				<h1 class="steading-title">Stonetop</h1>
			</div>
		</div>

		<div class="steading-stats-bar">

			{{!-- Surplus stacked on Fortunes --}}
			<div class="steading-statsbar-pair steading-edit-section{{#unless stonetop.edit.surplusFortunes}} stonetop-readonly{{/unless}}">
				{{> "stonetop.steading-section-toggle" section="surplusFortunes" editing=stonetop.edit.surplusFortunes}}
				<div class="steading-surplus-block">
					<label class="steading-stat-label" data-steading-stat="surplus">Surplus</label>
					<span class="steading-stat-hint">Starts at 1</span>
					{{#if stonetop.edit.surplusFortunes}}
					<input class="steading-surplus-input" type="number" name="system.attributes.surplus.value"
					       value="{{stonetop.system.attributes.surplus.value}}" min="0" max="99">
					{{else}}
					<span class="steading-surplus-value">{{stonetop.system.attributes.surplus.value}}</span>
					{{/if}}
				</div>
				<div class="steading-stat-block">
					<div class="steading-stat-label-row">
						<span class="steading-stat-label" data-steading-stat="fortunes">Fortunes</span>
						<span class="steading-stat-hint">Starts at +1</span>
					</div>
					<div class="steading-track">
						{{#each (steadingTrack stonetop.system.stats.fortunes.value 1)}}
						<label class="steading-track-option {{#if checked}}is-selected{{/if}}">
							<input type="radio" name="system.stats.fortunes.value" value="{{val}}" {{#if checked}}checked{{/if}} {{#unless ../stonetop.edit.surplusFortunes}}disabled{{/unless}}>
							<span class="steading-track-label">{{label}}</span>
						</label>
						{{/each}}
					</div>
				</div>
			</div>

			{{!-- Size stacked on Population --}}
			<div class="steading-statsbar-pair steading-edit-section{{#unless stonetop.edit.sizePopulation}} stonetop-readonly{{/unless}}">
				{{> "stonetop.steading-section-toggle" section="sizePopulation" editing=stonetop.edit.sizePopulation}}
				<div class="steading-stat-block">
					<div class="steading-stat-label-row">
						<span class="steading-stat-label" data-steading-stat="size">Size</span>
						<span class="steading-stat-hint">Starts at village</span>
					</div>
					<div class="steading-size-options">
						<label class="steading-size-option">
							<input type="radio" class="steading-size-radio" value="hamlet"
							       {{#if (eq stonetop.size "hamlet")}}checked{{/if}} {{#unless stonetop.edit.sizePopulation}}disabled{{/unless}}>
							<span><em>hamlet</em> (&lt;50 people)</span>
						</label>
						<label class="steading-size-option">
							<input type="radio" class="steading-size-radio" value="village"
							       {{#if (eq stonetop.size "village")}}checked{{/if}} {{#unless stonetop.edit.sizePopulation}}disabled{{/unless}}>
							<span><em>village</em> (150–350)</span>
						</label>
						<label class="steading-size-option">
							<input type="radio" class="steading-size-radio" value="town"
							       {{#if (eq stonetop.size "town")}}checked{{/if}} {{#unless stonetop.edit.sizePopulation}}disabled{{/unless}}>
							<span><em>town</em> (500–1500)</span>
						</label>
						<label class="steading-size-option">
							<input type="radio" class="steading-size-radio" value="city"
							       {{#if (eq stonetop.size "city")}}checked{{/if}} {{#unless stonetop.edit.sizePopulation}}disabled{{/unless}}>
							<span><em>city</em> (2500+)</span>
						</label>
					</div>
				</div>
				<div class="steading-stat-block">
					<div class="steading-stat-label-row">
						<span class="steading-stat-label" data-steading-stat="population">Population</span>
						<span class="steading-stat-hint">Starts at +0</span>
					</div>
					<div class="steading-track">
						{{#each (steadingTrack stonetop.system.attributes.population.value 0)}}
						<label class="steading-track-option {{#if checked}}is-selected{{/if}}">
							<input type="radio" name="system.attributes.population.value" value="{{val}}" {{#if checked}}checked{{/if}} {{#unless ../stonetop.edit.sizePopulation}}disabled{{/unless}}>
							<span class="steading-track-label">{{label}}</span>
						</label>
						{{/each}}
					</div>
				</div>
			</div>

			{{!-- Defenses/Fortifications --}}
			<div class="steading-defense-debility-group">
				<div class="steading-statsbar-pair steading-defense-fortification-col">
					<div class="steading-stat-block steading-defense-track-block steading-edit-section{{#unless stonetop.edit.defenses}} stonetop-readonly{{/unless}}">
						{{> "stonetop.steading-section-toggle" section="defenses" editing=stonetop.edit.defenses}}
						<div class="steading-stat-label-row">
							<span class="steading-stat-label" data-steading-stat="defenses">Defenses</span>
							<span class="steading-stat-hint">Starts at +0</span>
						</div>
						<div class="steading-track">
							{{#each (steadingDefenseTrack stonetop.system.stats.defenses.value 0)}}
							<label class="steading-track-option {{#if checked}}is-selected{{/if}}">
								<input type="radio" name="system.stats.defenses.value" value="{{val}}" {{#if checked}}checked{{/if}} {{#unless ../stonetop.edit.defenses}}disabled{{/unless}}>
								<span class="steading-track-label">{{label}}</span>
								<span class="steading-track-sublabel">{{sublabel}}</span>
							</label>
							{{/each}}
						</div>
					</div>
					<div class="steading-stat-block steading-fortifications-block steading-edit-section{{#unless stonetop.edit.fortifications}} stonetop-readonly{{/unless}}">
						{{> "stonetop.steading-section-toggle" section="fortifications" editing=stonetop.edit.fortifications}}
						<h3 class="steading-list-heading">Fortifications, etc.</h3>
						<ul class="steading-list">
							{{#each stonetop.fortifications}}
							{{#if name}}
							<li class="steading-list-item">
								<span class="steading-list-bullet" aria-hidden="true"></span>
								<span class="steading-list-name">{{name}}</span>
								<button type="button" class="steading-list-delete"
								        data-list="fortifications" data-index="{{@index}}"
								        title="Remove" tabindex="-1">
									<i class="fas fa-times"></i>
								</button>
							</li>
							{{/if}}
							{{/each}}
						</ul>
						{{#if stonetop.edit.fortifications}}
						<button type="button" class="steading-list-add" data-list="fortifications">
							<i class="fas fa-plus"></i> Add Fortification
						</button>
						{{/if}}
					</div>
				</div>
			</div>

			{{!-- Prosperity over Currency --}}
			<div class="steading-statsbar-col steading-prosperity-col">
				<div class="steading-stat-block steading-edit-section{{#unless stonetop.edit.prosperity}} stonetop-readonly{{/unless}}">
					{{> "stonetop.steading-section-toggle" section="prosperity" editing=stonetop.edit.prosperity}}
					<div class="steading-stat-label-row">
						<span class="steading-stat-label" data-steading-stat="prosperity">Prosperity</span>
						<span class="steading-stat-hint">Starts at +0</span>
					</div>
					<div class="steading-track">
						{{#each (steadingTrack stonetop.system.attributes.prosperity.value 0)}}
						<label class="steading-track-option {{#if checked}}is-selected{{/if}}">
							<input type="radio" name="system.attributes.prosperity.value" value="{{val}}" {{#if checked}}checked{{/if}} {{#unless ../stonetop.edit.prosperity}}disabled{{/unless}}>
							<span class="steading-track-label">{{label}}</span>
						</label>
						{{/each}}
					</div>
				</div>
				<div class="steading-currency-section steading-stat-block steading-edit-section{{#unless stonetop.edit.currency}} stonetop-readonly{{/unless}}">
					{{> "stonetop.steading-section-toggle" section="currency" editing=stonetop.edit.currency}}
					<div class="steading-currency-group">
						<h3 class="steading-list-heading">Silver</h3>
						<div class="steading-currency-row">
							<label class="steading-currency-field">
								<span class="steading-currency-field-legend">Purses</span>
								<input type="number" class="steading-currency-input" data-currency="silver" data-field="purses"
								       value="{{stonetop.silver.purses}}" min="0">
							</label>
							<label class="steading-currency-field">
								<span class="steading-currency-field-legend">Handfuls</span>
								<input type="number" class="steading-currency-input" data-currency="silver" data-field="handfuls"
								       value="{{stonetop.silver.handfuls}}" min="0">
							</label>
							<label class="steading-currency-field">
								<span class="steading-currency-field-legend">Coins</span>
								<input type="number" class="steading-currency-input" data-currency="silver" data-field="coins"
								       value="{{stonetop.silver.coins}}" min="0">
							</label>
						</div>
					</div>
					<div class="steading-currency-group">
						<h3 class="steading-list-heading">Gold</h3>
						<div class="steading-currency-row">
							<label class="steading-currency-field">
								<span class="steading-currency-field-legend">Purses</span>
								<input type="number" class="steading-currency-input" data-currency="gold" data-field="purses"
								       value="{{stonetop.gold.purses}}" min="0">
							</label>
							<label class="steading-currency-field">
								<span class="steading-currency-field-legend">Handfuls</span>
								<input type="number" class="steading-currency-input" data-currency="gold" data-field="handfuls"
								       value="{{stonetop.gold.handfuls}}" min="0">
							</label>
							<label class="steading-currency-field">
								<span class="steading-currency-field-legend">Coins</span>
								<input type="number" class="steading-currency-input" data-currency="gold" data-field="coins"
								       value="{{stonetop.gold.coins}}" min="0">
							</label>
						</div>
					</div>
				</div>
			</div>

			{{!-- Debilities --}}
			{{!-- Debilities are always editable for owners: they flip often during play
			      and the three checkboxes are low-risk, so they skip the per-section edit
			      pencil. Non-owners still see them read-only. --}}
			<div class="steading-debilities-section steading-stat-block steading-debilities-section--full-row{{#unless stonetop.canEdit}} stonetop-readonly{{/unless}}">
				<span class="steading-section-label">Debilities</span>
				<div class="steading-debilities">
					<div class="steading-debility">
						<label class="steading-debility-control"
						       data-tooltip="Disadvantage to Deploy, Muster, or Pull Together"
						       data-tooltip-direction="UP">
							<input type="checkbox" class="steading-debility-check"
							       name="system.attributes.debilities.options.diminished.value"
							       {{#if stonetop.system.attributes.debilities.options.diminished.value}}checked{{/if}}>
							<span class="steading-debility-name"><em>diminished</em></span>
						</label>
						<span class="steading-debility-desc">by injury/sickness/doubt</span>
					</div>
					<div class="steading-debility">
						<label class="steading-debility-control"
						       data-tooltip="Treat Prosperity as if it's 1 lower than it is"
						       data-tooltip-direction="UP">
							<input type="checkbox" class="steading-debility-check"
							       name="system.attributes.debilities.options.lacking.value"
							       {{#if stonetop.system.attributes.debilities.options.lacking.value}}checked{{/if}}>
							<span class="steading-debility-name"><em>lacking</em></span>
						</label>
						<span class="steading-debility-desc">due to shortages/hoarding/distrust</span>
					</div>
					<div class="steading-debility">
						<label class="steading-debility-control"
						       data-tooltip="Fortunes reset to +0 each season, not +1; folks need Persuading more often"
						       data-tooltip-direction="UP">
							<input type="checkbox" class="steading-debility-check"
							       name="system.attributes.debilities.options.malcontent.value"
							       {{#if stonetop.system.attributes.debilities.options.malcontent.value}}checked{{/if}}>
							<span class="steading-debility-name"><em>malcontent</em></span>
						</label>
						<span class="steading-debility-desc">from fear/anger/despair</span>
					</div>
				</div>
			</div>

		</div>

		<nav class="sheet-tabs tabs" data-group="primary">
			<a class="item" data-tab="overview">{{localize "stonetop.steading.tabs.overview"}}</a>
			<a class="item" data-tab="neighbors">{{localize "stonetop.steading.tabs.neighbors"}}</a>
			<a class="item" data-tab="improvements">{{localize "stonetop.steading.tabs.improvements"}}</a>
			<a class="item" data-tab="notes">{{localize "stonetop.steading.tabs.notes"}}</a>
		</nav>

		<div class="stonetop-sheet-layout steading-sheet-layout">
			<section class="sheet-body">
				{{> "stonetop.steading-tab-overview"}}
				{{> "stonetop.steading-tab-neighbors"}}
				{{> "stonetop.steading-tab-improvements"}}
				{{> "stonetop.steading-tab-notes"}}
			</section>

			<div class="stonetop-moves-sidebar steading-moves-sidebar{{#if stonetop.sidebarCollapsed}} is-collapsed{{/if}}">
				<button type="button" class="stonetop-sidebar-toggle"
				        aria-expanded="{{#if stonetop.sidebarCollapsed}}false{{else}}true{{/if}}"
				        aria-label="{{#if stonetop.sidebarCollapsed}}Expand moves sidebar{{else}}Collapse moves sidebar{{/if}}">
					<i class="fas fa-chevron-right"></i>
				</button>
				<div class="stonetop-sidebar-body">
				{{> "stonetop.section-heading" title="Roll Modifier"}}
				<div class="stonetop-roll-mode-control" role="group" aria-label="Roll mode">
					<label class="stonetop-roll-mode-option{{#if (eq stonetop.rollMode "adv")}} is-checked{{/if}}">
						<input type="radio" class="stonetop-roll-mode-input" name="stonetop-roll-mode" value="adv"
						       {{#if (eq stonetop.rollMode "adv")}}checked{{/if}}>
						<span>Advantage</span>
					</label>
					<label class="stonetop-roll-mode-option{{#if (eq stonetop.rollMode "normal")}} is-checked{{/if}}">
						<input type="radio" class="stonetop-roll-mode-input" name="stonetop-roll-mode" value="normal"
						       {{#if (eq stonetop.rollMode "normal")}}checked{{/if}}>
						<span>Normal</span>
					</label>
					<label class="stonetop-roll-mode-option{{#if (eq stonetop.rollMode "dis")}} is-checked{{/if}}">
						<input type="radio" class="stonetop-roll-mode-input" name="stonetop-roll-mode" value="dis"
						       {{#if (eq stonetop.rollMode "dis")}}checked{{/if}}>
						<span>Disadvantage</span>
					</label>
				</div>

				{{> "stonetop.section-heading" title=(localize "stonetop.steading.tabs.moves")}}
				{{> "stonetop.steading-tab-moves"}}
				</div>
			</div>
		</div>

	</div>
</form>
