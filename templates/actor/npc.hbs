<form class="{{cssClass}} stonetop-follower-card" autocomplete="off">
	<div class="sheet-wrapper">
		<div>
			{{> "stonetop.actor-header"}}

			<section>
				<div>
					<section>
						<div class="stonetop-npc-attrs stonetop-follower-attrs">
							<div class="stonetop-resource stonetop-resource--small stonetop-resource--follower">
								<div class="flexrow">
									<span class="stonetop-resource__label">{{localize "stonetop.followers.damage"}}</span>
									{{> "stonetop.editable-field" html=stonetop.damageHtml value=stonetop.damage
										inputId="npc-damage" inputClass="stonetop-resource__input" slug=slug}}
								</div>
							</div>
							<div class="stonetop-resource stonetop-resource--small stonetop-resource--follower">
								<span class="stonetop-resource__label">{{localize "stonetop.followers.hp"}}</span>
								<div class="stonetop-resource__split">
									<input id="npc-hp" type="number" class="stonetop-resource__input stonetop-follower-hp" min="0" value="{{stonetop.hp}}" data-slug="{{slug}}">
									<span>/</span>
									<input id="npc-max-hp" type="number" class="stonetop-resource__input stonetop-follower-hp-max" min="0" value="{{stonetop.hpMax}}" data-slug="{{slug}}">
								</div>
							</div>
							<div id="npc-armor-box" class="stonetop-creature-line">
								<span class="stonetop-resource__label">{{localize "stonetop.followers.armor"}}</span>
								{{> "stonetop.editable-field" html=stonetop.armorHtml value=stonetop.armor
									inputId="npc-armor" inputClass="stonetop-resource__input" slug=slug}}
							</div>
						</div>
					</section>

					<section>
						<div class="flexcolumn">
							<div>
								<span class="stonetop-follower-label">Instinct</span>
								{{> "stonetop.editable-field" html=stonetop.instinctHtml value=stonetop.instinct
									inputId="npc-instinct" inputClass="stonetop-follower-metadata-input" multiline=true slug=slug}}
							</div>
							<div>
								<span class="stonetop-follower-label">Special Qualities</span>
								{{> "stonetop.editable-field" html=stonetop.specialQualityHtml value=stonetop.specialQuality
									inputId="npc-special-qualities" inputClass="stonetop-follower-metadata-input" slug=slug}}
							</div>
						</div>
					</section>
				</div>
			</section>

		</div>

		<section class="flexcol">
			{{#if stonetop.moves}}
			<div>
				<span class="stonetop-follower-label">{{localize "stonetop.followers.moves"}}</span>
				<div style="min-height: 50px;">

				</div>
			</div>
			{{/if}}
			<span class="stonetop-follower-label">{{localize "stonetop.followers.description"}}</span>
			{{> "stonetop.editable-field" html=stonetop.descriptionHtml value=stonetop.description slug=slug
				multiline=true inputClass="stonetop-follower-description-textarea stonetop-notes st-notes-textarea"}}
		</section>

	</div>
</form>