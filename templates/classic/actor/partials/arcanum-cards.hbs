{{#each items}}
{{#if owned}}
<div class="stonetop-arcanum-card{{#if flipped}} is-flipped{{/if}}" data-slug="{{slug}}">

	{{#if img}}
	<img class="stonetop-arcanum-img" src="{{img}}" alt="{{name}}">
	{{/if}}

	{{#if flipped}}
	{{!-- Back side --}}
	<div class="stonetop-arcanum-header">
		<div class="stonetop-arcanum-header-left">
			<span class="stonetop-arcanum-title">{{back.title}}</span>
			{{#if back.item}}{{> "classic.outfit-item-row" back.item}}{{/if}}
		</div>
		{{#if back.resource}}
		<div class="stonetop-arcanum-header-resource">
			{{> "classic.resource-track" resource=back.resource btnClass="stonetop-arcanum-resource-btn" slug=slug}}
		</div>
		{{/if}}
	</div>
	<div class="stonetop-arcanum-body">
		<div class="stonetop-rich">{{{md back.description}}}</div>
		{{#each back.moves}}
		<p class="stonetop-arcanum-move-trigger"><strong>{{name}}</strong>{{#if subtitle}} <span class="stonetop-arcanum-move-subtitle">{{subtitle}}</span>{{/if}}</p>
		<div class="stonetop-rich">{{{md text}}}</div>
		{{/each}}
		{{#if back.choices}}
		<div class="stonetop-arcanum-back-choices">
			{{#each back.choices.list}}
			{{> "classic.choice-row" cgContext="arcana-back" cgGroup=../slug}}
			{{/each}}
		</div>
		{{/if}}
		{{#if back.consequences}}
		<div class="stonetop-arcanum-consequences">
			<p class="stonetop-arcanum-consequences-label">{{localize "stonetop.arcana.consequences"}}</p>
			{{#each back.consequences.list}}
			{{> "classic.choice-row"}}
			{{/each}}
		</div>
		{{/if}}
	</div>

	{{else}}
	{{!-- Front side --}}
	<div class="stonetop-arcanum-header">
		<div class="stonetop-arcanum-header-left">
			<span class="stonetop-arcanum-title">{{front.title}}</span>
			{{#if front.item}}{{> "classic.outfit-item-row" front.item}}{{/if}}
		</div>
	</div>
	<div class="stonetop-arcanum-body">
		<div class="stonetop-rich">{{{md front.description}}}</div>
		<div class="stonetop-arcanum-unlock">
			{{#each front.unlock.list}}
			{{> "classic.choice-row" cgContext="arcana-unlock" cgGroup=../slug}}
			{{/each}}
		</div>
	</div>
	{{/if}}

	<div class="stonetop-arcanum-footer">
		<button type="button" class="stonetop-arcanum-flip-btn"
		        data-slug="{{slug}}" data-flipped="{{flipped}}">
			{{#if flipped}}{{localize "stonetop.arcana.showFront"}}{{else}}{{localize "stonetop.arcana.showBack"}}{{/if}}
		</button>
		{{#if isCustom}}
		<button type="button" class="stonetop-arcanum-edit" data-slug="{{slug}}"
		        title="{{localize 'stonetop.arcana.editCustom'}}">
			<i class="fas fa-pen-to-square"></i>
		</button>
		{{/if}}
		<button type="button" class="stonetop-arcanum-delete" data-slug="{{slug}}"
		        title="{{localize 'stonetop.arcana.removeArcanum'}}">
			<i class="fas fa-times"></i>
		</button>
	</div>

</div>
{{/if}}
{{/each}}
