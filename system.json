		{
			"name": "Dice-Goblin-Click-Clack",
			"flags": {}
		},
		{
			"name": "dwpowell88",
			"flags": {}
		}
	],
	"flags": {
		"hotReload": {
			"extensions": [
				"css",
				"js",
				"hbs",
				"json"
			],
			"paths": [
				"stonetop.js",
				"module",
				"styles",
				"languages",
				"templates"
			]
		}
	},
	"esmodules": [
		"dist/stonetop.js"
	],
	"styles": [
		{
			"src": "styles/themes/palette.css"
		},
		{
			"src": "styles/themes/parchment-light.css"
		},
		{
			"src": "styles/themes/parchment-dark.css"
		},
		{
			"src": "styles/tokens.css"
		},
		{
			"src": "styles/stonetop.css"
		}
	],
	"languages": [
		{
			"lang": "en",
			"name": "English",
			"path": "languages/en.json",
			"flags": {}
		},
		{
			"lang": "de",
			"name": "Deutsch",
			"path": "languages/de.json",
			"flags": {}
		}
	],
	"relationships": {
		"recommends": [
			{
				"id": "babele",
				"type": "module",
				"reason": "Translates the compendiums. The system is fully playable in English without it.",
				"compatibility": {}
			}
		]
	},
